# Any secret below can instead come from a Docker secret file: leave it out of
# this file and set <NAME>_FILE=/run/secrets/<file> in the container. A secret
# file beats a value here. The supported names, and the processes that receive
# each one, are in docker/secret_env_vars.yaml.
#
# The Exa, Brave Search and Crawl4AI keys do not belong here: they are kept in
# the credential store. Onboarding stores the Exa and Brave keys typed there;
# an administrator links or changes them in chat with /link http:exa team,
# /link http:brave-search team, /link http:crawl4ai team and
# /link mcp:crawl4ai team. Startup refuses them in this file.

# Activity Monitoring Interface
ACTIVITY_COLLECTOR_ADMIN_TOKEN="<RANDOM_TOKEN>"
ACTIVITY_COLLECTOR_INGEST_TOKEN="<RANDOM_TOKEN>"
ACTIVITY_COLLECTOR_USER_TOKEN="<RANDOM_TOKEN>"

# Crawl4AI MCP config
CRAWL4AI_MCP_SERVER_URL="<local_url>:<port>/mcp/sse"

# Discord Config
DISCORD_BOT_TOKEN="<DISCORD_BOT_TOKEN>"

# Model keys: leave these unset and save keys with /auth model in chat (tested before they are stored, and
# used without a restart). When set here, a variable overrides the key saved for its endpoint until it is
# removed and the container restarted.
# EMBEDDING_API_KEY="<EMBEDDING_API_TOKEN>"

# Google keyring password
GOG_KEYRING_PASSWORD="<RANDOM_TOKEN>"

# OpenAI API compatible endpoint key override (LiteLLM, OpenRouter, Bifrost, ...); see the note above.
# LITELLM_API_KEY="<OPENAPI_PROVIDER_TOKEN>"

# NATS Password
NATS_PASSWORD="<RANDOM_TOKEN>"
NATS_USER=team_agent

# Otel Config
OTEL_SDK_DISABLED=true

# iMessage Config
PHOTON_PROJECT_ID="<PHOTON_PROJECT_ID>"
PHOTON_PROJECT_SECRET="<PHOTON_PROJECT_SECRET>"

# SEARXNG Service Config
SEARXNG_BASE_URL="<your_service_url>"
SEARXNG_DEFAULT_NUM_RESULTS=20
SEARXNG_TIMEOUT_SECONDS=15
SEARXNG_VERIFY_TLS=false

# Secure broker secret. The supervisor gives the broker this value and every
# other process its own token derived from it, so the broker knows which
# process called.
SECURE_TOOL_BROKER_TOKEN="<RANDOM_TOKEN>"

# Task-context signing keys: ACCESS_GATEWAY_SIGNING_KEY,
# ACCESS_SCHEDULER_SIGNING_KEY and ACCESS_CONTEXT_VERIFY_KEYS are generated by
# the internal credentials step and written to team.env; do not copy or edit
# them by hand. The gateway signs people's tasks, the scheduler signs scheduled
# runs, and every other process gets only the public keys.

# Telegram Config
TELEGRAM_BOT_TOKEN="<TELEGRAM_BOT_TOKEN>"

# Web Chat Login PW
WEB_CHAT_AUTH_TOKEN="<RANDOM_TOKEN>"

# xAI API Key (voice generation)
XAI_API_KEY="<XAI_API_KEY>"
