{
  "$defs": {
    "JsonValue": {},
    "MCPToolDefinitionV1": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "default": "",
          "maxLength": 4000,
          "title": "Description",
          "type": "string"
        },
        "inputSchema": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Inputschema",
          "type": "object"
        },
        "name": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "operation_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Operation Digest",
          "type": "string"
        },
        "outputSchema": {
          "anyOf": [
            {
              "additionalProperties": {
                "$ref": "#/$defs/JsonValue"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Outputschema"
        }
      },
      "required": [
        "name",
        "inputSchema",
        "operation_digest"
      ],
      "title": "MCPToolDefinitionV1",
      "type": "object"
    }
  },
  "$id": "https://universal-agents.dev/schemas/mcp/v1/MCPDiscoveryResponseV1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "connection_id": {
      "maxLength": 240,
      "minLength": 1,
      "title": "Connection Id",
      "type": "string"
    },
    "descriptor_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Descriptor Sha256",
      "type": "string"
    },
    "operation_catalog_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Operation Catalog Sha256",
      "type": "string"
    },
    "record_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Record Digest",
      "type": "string"
    },
    "record_type": {
      "const": "mcp_discovery_response",
      "default": "mcp_discovery_response",
      "title": "Record Type",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "tools": {
      "items": {
        "$ref": "#/$defs/MCPToolDefinitionV1"
      },
      "title": "Tools",
      "type": "array"
    }
  },
  "required": [
    "connection_id",
    "record_digest",
    "descriptor_sha256",
    "operation_catalog_sha256",
    "tools"
  ],
  "title": "MCPDiscoveryResponseV1",
  "type": "object"
}
