{
  "$defs": {
    "AuthorityTokenAudienceRecord": {
      "additionalProperties": false,
      "properties": {
        "installation": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,61}$",
          "title": "Installation",
          "type": "string"
        },
        "team": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,23}$",
          "title": "Team",
          "type": "string"
        }
      },
      "required": [
        "installation",
        "team"
      ],
      "title": "AuthorityTokenAudienceRecord",
      "type": "object"
    },
    "AuthorityTokenBoundToAccessRequestRecord": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@-]{0,127}$",
          "title": "Id",
          "type": "string"
        },
        "type": {
          "const": "access_request",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "id"
      ],
      "title": "AuthorityTokenBoundToAccessRequestRecord",
      "type": "object"
    },
    "AuthorityTokenBoundToCommandRecord": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@-]{0,127}$",
          "title": "Id",
          "type": "string"
        },
        "type": {
          "const": "command",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "id"
      ],
      "title": "AuthorityTokenBoundToCommandRecord",
      "type": "object"
    },
    "AuthorityTokenBoundToRootTaskRecord": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@-]{0,127}$",
          "title": "Id",
          "type": "string"
        },
        "request_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@-]{0,127}$",
          "title": "Request Id",
          "type": "string"
        },
        "type": {
          "const": "root_task",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "id",
        "request_id"
      ],
      "title": "AuthorityTokenBoundToRootTaskRecord",
      "type": "object"
    },
    "AuthorityTokenIssuerRecord": {
      "additionalProperties": false,
      "properties": {
        "installation": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,61}$",
          "title": "Installation",
          "type": "string"
        },
        "key_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Key Id",
          "type": "string"
        },
        "membership_epoch": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Membership Epoch",
          "type": "integer"
        },
        "runtime": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
          "title": "Runtime",
          "type": "string"
        }
      },
      "required": [
        "installation",
        "runtime",
        "membership_epoch",
        "key_id"
      ],
      "title": "AuthorityTokenIssuerRecord",
      "type": "object"
    },
    "AuthorityTokenRecord": {
      "additionalProperties": false,
      "description": "Lightweight Pydantic model with the exact wire shape of ``custom_messages.wire.models.AuthorityToken``.\n\nUsed on old-wrapper contracts (``GatewayContext.task_context``, ``ScheduleRunIdentityV1.permit``,\n``MCPInvocationRequestV1.task_context``) so importing gateway or CLI modules does not load the\nfull generated ``custom_messages.wire.models`` module while still rejecting legacy signed\ncontexts and preserving exact protocol 1 JSON serialization.",
      "properties": {
        "algorithm": {
          "const": "ed25519",
          "title": "Algorithm",
          "type": "string"
        },
        "audience": {
          "$ref": "#/$defs/AuthorityTokenAudienceRecord"
        },
        "bound_to": {
          "discriminator": {
            "mapping": {
              "access_request": "#/$defs/AuthorityTokenBoundToAccessRequestRecord",
              "command": "#/$defs/AuthorityTokenBoundToCommandRecord",
              "root_task": "#/$defs/AuthorityTokenBoundToRootTaskRecord"
            },
            "propertyName": "type"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/AuthorityTokenBoundToRootTaskRecord"
            },
            {
              "$ref": "#/$defs/AuthorityTokenBoundToCommandRecord"
            },
            {
              "$ref": "#/$defs/AuthorityTokenBoundToAccessRequestRecord"
            }
          ],
          "title": "Bound To"
        },
        "expires_at": {
          "pattern": "^(19[7-9][0-9]|[2-9][0-9]{3})-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z$",
          "title": "Expires At",
          "type": "string"
        },
        "issued_at": {
          "pattern": "^(19[7-9][0-9]|[2-9][0-9]{3})-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z$",
          "title": "Issued At",
          "type": "string"
        },
        "issuer": {
          "$ref": "#/$defs/AuthorityTokenIssuerRecord"
        },
        "person": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$",
          "title": "Person",
          "type": "string"
        },
        "schedule_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@-]{0,127}$",
          "title": "Schedule Id",
          "type": "string"
        },
        "signature": {
          "pattern": "^[A-Za-z0-9_-]{86}$",
          "title": "Signature",
          "type": "string"
        },
        "token_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "title": "Token Id",
          "type": "string"
        }
      },
      "required": [
        "token_id",
        "issuer",
        "audience",
        "bound_to",
        "issued_at",
        "expires_at",
        "algorithm",
        "signature"
      ],
      "title": "AuthorityTokenRecord",
      "type": "object"
    },
    "ContractJsonValue": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "integer"
        },
        {
          "type": "string"
        },
        {
          "items": {
            "$ref": "#/$defs/ContractJsonValue"
          },
          "type": "array"
        },
        {
          "additionalProperties": {
            "$ref": "#/$defs/ContractJsonValue"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "JsonValue": {},
    "PrincipalDescriptorV1": {
      "additionalProperties": false,
      "description": "Who a request acts as, and for which person (``on_behalf_of_user_id``).",
      "properties": {
        "attributes": {
          "additionalProperties": {
            "$ref": "#/$defs/ContractJsonValue"
          },
          "title": "Attributes",
          "type": "object"
        },
        "named_agent_type": {
          "anyOf": [
            {
              "maxLength": 240,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Named Agent Type"
        },
        "on_behalf_of_user_id": {
          "anyOf": [
            {
              "maxLength": 240,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "On Behalf Of User Id"
        },
        "principal_id": {
          "maxLength": 240,
          "minLength": 1,
          "title": "Principal Id",
          "type": "string"
        },
        "principal_type": {
          "$ref": "#/$defs/PrincipalType"
        },
        "roles": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Roles",
          "type": "array"
        },
        "team_id": {
          "anyOf": [
            {
              "maxLength": 240,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Team Id"
        }
      },
      "required": [
        "principal_type",
        "principal_id"
      ],
      "title": "PrincipalDescriptorV1",
      "type": "object"
    },
    "PrincipalType": {
      "enum": [
        "User",
        "Agent",
        "Service",
        "System"
      ],
      "title": "PrincipalType",
      "type": "string"
    },
    "ScheduleRunIdentityV1": {
      "additionalProperties": false,
      "description": "Who one scheduled run works for: its schedule's protocol 1 permit token and this run's own fields.\n\nTravels in ``GatewayContext.schedule_run`` on the old wrapper (Step 5) when a scheduled\nrun uses its schedule's standing scheduler-signed permit token. ``context_id``,\n``conversation_id`` and ``started_at_utc`` are not signed: they tie the run's tasks\ntogether and date the run, and grant nothing. Steps 6–7 will replace this wrapper once\nqueued work moves onto protocol 1 ``task.request`` frames whose ``verify_frame`` binds\n``/body/work/root_task_id`` directly to ``token.bound_to.id``.",
      "properties": {
        "context_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^schedule_run_",
          "title": "Context Id",
          "type": "string"
        },
        "conversation_id": {
          "anyOf": [
            {
              "maxLength": 240,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Conversation Id"
        },
        "permit": {
          "$ref": "#/$defs/AuthorityTokenRecord"
        },
        "started_at_utc": {
          "format": "date-time",
          "title": "Started At Utc",
          "type": "string"
        }
      },
      "required": [
        "permit",
        "context_id",
        "started_at_utc"
      ],
      "title": "ScheduleRunIdentityV1",
      "type": "object"
    }
  },
  "$id": "https://universal-agents.dev/schemas/mcp/v1/MCPInvocationRequestV1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "arguments": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Arguments",
      "type": "object"
    },
    "operation_name": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Operation Name",
      "type": "string"
    },
    "principal": {
      "$ref": "#/$defs/PrincipalDescriptorV1"
    },
    "record_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Record Digest",
      "type": "string"
    },
    "record_type": {
      "const": "mcp_invocation_request",
      "default": "mcp_invocation_request",
      "title": "Record Type",
      "type": "string"
    },
    "schedule_run": {
      "anyOf": [
        {
          "$ref": "#/$defs/ScheduleRunIdentityV1"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "task_context": {
      "anyOf": [
        {
          "$ref": "#/$defs/AuthorityTokenRecord"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "task_id": {
      "default": "",
      "maxLength": 240,
      "title": "Task Id",
      "type": "string"
    },
    "tool_use_id": {
      "maxLength": 240,
      "minLength": 1,
      "title": "Tool Use Id",
      "type": "string"
    }
  },
  "required": [
    "record_digest",
    "operation_name",
    "tool_use_id",
    "principal"
  ],
  "title": "MCPInvocationRequestV1",
  "type": "object"
}
