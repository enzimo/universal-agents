    "proposal_id",
    "installed_at_utc",
    "installed_by_principal_id",
    "team_id",
    "owner_canonical_user_id",
    "handler_id",
    "handler_descriptor_digest",
    "input_schema_digest",
    "display_name",
    "description",
    "impact_description",
