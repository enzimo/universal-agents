      "type": "string"
    },
    "definition_id": {
      "title": "Definition Id",
      "type": "string"
    },
    "description": {
      "title": "Description",
      "type": "string"
    },
    "display_name": {
      "title": "Display Name",
      "type": "string"
    },
    "handler_descriptor_digest": {
      "title": "Handler Descriptor Digest",
      "type": "string"
    },
    "handler_id": {
      "title": "Handler Id",
      "type": "string"
    },
    "impact_description": {
      "title": "Impact Description",
      "type": "string"
    },
    "input_schema_digest": {
      "title": "Input Schema Digest",
      "type": "string"
    },
