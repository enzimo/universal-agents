{
  "$defs": {
    "CatalogCredentialField": {
      "properties": {
        "generation_policy": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Generation Policy"
        },
        "kind": {
          "default": "custom",
          "title": "Kind",
          "type": "string"
        },
        "resolution_order": {
          "items": {
            "$ref": "#/$defs/CatalogSourceRef"
          },
          "title": "Resolution Order",
          "type": "array"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "value_source": {
          "default": "existing_source",
          "title": "Value Source",
          "type": "string"
        },
        "visibility": {
          "default": "secret",
          "title": "Visibility",
          "type": "string"
        }
      },
      "title": "CatalogCredentialField",
      "type": "object"
    },
    "CatalogSourceRef": {
      "properties": {
        "env_var": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Env Var"
        },
        "field_ref": {
          "default": "password",
          "title": "Field Ref",
          "type": "string"
        },
        "file_fallback": {
          "default": true,
          "title": "File Fallback",
          "type": "boolean"
        },
        "folder": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Folder"
        },
        "item_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Item Id"
        },
        "item_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Item Name"
        },
        "source": {
          "description": "Credential source type: env, sealbox, bitwarden, vault, onepassword, or keepass.",
          "title": "Source",
          "type": "string"
        },
        "vault": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Vault"
        }
      },
      "required": [
        "source"
      ],
      "title": "CatalogSourceRef",
      "type": "object"
    }
  },
  "$id": "https://universal-agents.dev/schemas/team-transfer/v1/CatalogCredential.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "A saved credential: its fields and where each secret is stored.\n\nWhich tool uses a credential, and where its values go (a header, a query\nvalue, or an environment variable), is an account link\n(``AccountLinkV1``), not part of the credential. Credentials saved before\naccount links may still carry a ``bindings`` key; the default pydantic\nconfig ignores it, and the next save drops it.",
  "properties": {
    "approval": {
      "additionalProperties": true,
      "title": "Approval",
      "type": "object"
    },
    "created_at": {
      "title": "Created At",
      "type": "string"
    },
    "display_name": {
      "title": "Display Name",
      "type": "string"
    },
    "fields": {
      "additionalProperties": {
        "$ref": "#/$defs/CatalogCredentialField"
      },
      "title": "Fields",
      "type": "object"
    },
    "purpose": {
      "title": "Purpose",
      "type": "string"
    },
    "updated_at": {
      "title": "Updated At",
      "type": "string"
    }
  },
  "required": [
    "display_name",
    "purpose"
  ],
  "title": "CatalogCredential",
  "type": "object"
}
