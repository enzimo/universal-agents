{
  "$defs": {
    "CatalogEntryV1": {
      "additionalProperties": false,
      "properties": {
        "credential": {
          "additionalProperties": true,
          "title": "Credential",
          "type": "object"
        },
        "credential_key": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Credential Key",
          "type": "string"
        },
        "kind": {
          "const": "catalog_entry",
          "default": "catalog_entry",
          "title": "Kind",
          "type": "string"
        },
        "owner": {
          "$ref": "#/$defs/CredentialOwnerV1"
        },
        "secret_values": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Secret Values",
          "type": "object"
        }
      },
      "required": [
        "owner",
        "credential_key",
        "credential"
      ],
      "title": "CatalogEntryV1",
      "type": "object"
    },
    "CredentialOwnerV1": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "team",
            "person"
          ],
          "title": "Kind",
          "type": "string"
        },
        "owner_id": {
          "maxLength": 240,
          "minLength": 1,
          "title": "Owner Id",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "owner_id"
      ],
      "title": "CredentialOwnerV1",
      "type": "object"
    },
    "ModelKeyV1": {
      "additionalProperties": false,
      "properties": {
        "entry": {
          "additionalProperties": true,
          "title": "Entry",
          "type": "object"
        },
        "kind": {
          "const": "model_key",
          "default": "model_key",
          "title": "Kind",
          "type": "string"
        },
        "owner": {
          "$ref": "#/$defs/CredentialOwnerV1"
        }
      },
      "required": [
        "owner",
        "entry"
      ],
      "title": "ModelKeyV1",
      "type": "object"
    },
    "OwnerFileV1": {
      "additionalProperties": false,
      "properties": {
        "content_b64": {
          "title": "Content B64",
          "type": "string"
        },
        "kind": {
          "const": "owner_file",
          "default": "owner_file",
          "title": "Kind",
          "type": "string"
        },
        "owner": {
          "$ref": "#/$defs/CredentialOwnerV1"
        },
        "path": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        }
      },
      "required": [
        "owner",
        "path",
        "content_b64"
      ],
      "title": "OwnerFileV1",
      "type": "object"
    },
    "StoredValueV1": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "stored_value",
          "default": "stored_value",
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "owner": {
          "$ref": "#/$defs/CredentialOwnerV1"
        },
        "value": {
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "owner",
        "name",
        "value"
      ],
      "title": "StoredValueV1",
      "type": "object"
    },
    "TemplateOverridesV1": {
      "additionalProperties": false,
      "properties": {
        "content": {
          "title": "Content",
          "type": "string"
        },
        "kind": {
          "const": "template_overrides",
          "default": "template_overrides",
          "title": "Kind",
          "type": "string"
        },
        "owner": {
          "$ref": "#/$defs/CredentialOwnerV1"
        }
      },
      "required": [
        "owner",
        "content"
      ],
      "title": "TemplateOverridesV1",
      "type": "object"
    }
  },
  "$id": "https://universal-agents.dev/schemas/team-transfer/v1/BrokerCredentialsDocumentV1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The plaintext shape of the ``broker_credentials`` transfer section (for its tracked schema).",
  "properties": {
    "records": {
      "items": {
        "anyOf": [
          {
            "$ref": "#/$defs/StoredValueV1"
          },
          {
            "$ref": "#/$defs/ModelKeyV1"
          },
          {
            "$ref": "#/$defs/CatalogEntryV1"
          },
          {
            "$ref": "#/$defs/OwnerFileV1"
          },
          {
            "$ref": "#/$defs/TemplateOverridesV1"
          }
        ]
      },
      "title": "Records",
      "type": "array"
    }
  },
  "title": "BrokerCredentialsDocumentV1",
  "type": "object"
}
