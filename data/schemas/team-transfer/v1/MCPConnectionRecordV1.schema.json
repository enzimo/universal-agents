{
  "$defs": {
    "ChangeApprovalMode": {
      "enum": [
        "person_approval",
        "held_access",
        "agreement",
        "operator_configuration"
      ],
      "title": "ChangeApprovalMode",
      "type": "string"
    },
    "ChangeApprovalRecordV1": {
      "additionalProperties": false,
      "description": "How a staged change was approved, kept with what it created.\n\nSaved in approved configuration (team roster attachments, MCP connection\napprovals, generated specialists) and in receipts. ``access_request_id``\nnames the Inbox request a person approved; it is empty when a person\nre-approved existing configuration from the command line.",
      "properties": {
        "access_request_id": {
          "anyOf": [
            {
              "maxLength": 120,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Access Request Id"
        },
        "approved_at_utc": {
          "format": "date-time",
          "title": "Approved At Utc",
          "type": "string"
        },
        "approved_by": {
          "maxLength": 240,
          "minLength": 1,
          "title": "Approved By",
          "type": "string"
        },
        "mode": {
          "$ref": "#/$defs/ChangeApprovalMode"
        }
      },
      "required": [
        "mode",
        "approved_by",
        "approved_at_utc"
      ],
      "title": "ChangeApprovalRecordV1",
      "type": "object"
    },
    "MCPConnectionDescriptorV1": {
      "additionalProperties": false,
      "description": "Secret-free immutable description of one exact MCP endpoint intent.",
      "properties": {
        "args": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Args",
          "type": "array"
        },
        "command": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Command"
        },
        "connection_name": {
          "title": "Connection Name",
          "type": "string"
        },
        "credential_env_names": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Credential Env Names",
          "type": "array"
        },
        "credential_injections": {
          "default": [],
          "items": {
            "$ref": "#/$defs/MCPCredentialInjectionV1"
          },
          "title": "Credential Injections",
          "type": "array"
        },
        "endpoint": {
          "anyOf": [
            {
              "maxLength": 2048,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Endpoint"
        },
        "exclude_tools": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Exclude Tools",
          "type": "array"
        },
        "header_names": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Header Names",
          "type": "array"
        },
        "include_tools": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Include Tools",
          "type": "array"
        },
        "literal_credential_material_present": {
          "default": false,
          "title": "Literal Credential Material Present",
          "type": "boolean"
        },
        "operation_timeout_seconds": {
          "default": 300.0,
          "exclusiveMinimum": 0,
          "maximum": 3600,
          "title": "Operation Timeout Seconds",
          "type": "number"
        },
        "owner_canonical_user_id": {
          "maxLength": 240,
          "minLength": 1,
          "title": "Owner Canonical User Id",
          "type": "string"
        },
        "schema_version": {
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "server_url_env": {
          "anyOf": [
            {
              "maxLength": 160,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Server Url Env"
        },
        "source": {
          "$ref": "#/$defs/MCPConnectionSource"
        },
        "source_config_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Config Sha256",
          "type": "string"
        },
        "source_locator": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Source Locator",
          "type": "string"
        },
        "startup_timeout_seconds": {
          "default": 30.0,
          "exclusiveMinimum": 0,
          "maximum": 600,
          "title": "Startup Timeout Seconds",
          "type": "number"
        },
        "stdio_env_names": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Stdio Env Names",
          "type": "array"
        },
        "team_id": {
          "maxLength": 240,
          "minLength": 1,
          "title": "Team Id",
          "type": "string"
        },
        "tool_name_prefix": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Tool Name Prefix",
          "type": "string"
        },
        "transport": {
          "$ref": "#/$defs/MCPConnectionTransport"
        }
      },
      "required": [
        "connection_name",
        "source",
        "source_locator",
        "team_id",
        "owner_canonical_user_id",
        "transport",
        "tool_name_prefix",
        "source_config_sha256"
      ],
      "title": "MCPConnectionDescriptorV1",
      "type": "object"
    },
    "MCPConnectionLifecycle": {
      "enum": [
        "pending",
        "active",
        "rejected",
        "disabled",
        "drifted",
        "removed"
      ],
      "title": "MCPConnectionLifecycle",
      "type": "string"
    },
    "MCPConnectionSource": {
      "enum": [
        "static_global",
        "static_agent_type",
        "configured_profile",
        "agent_proposal",
        "hosted"
      ],
      "title": "MCPConnectionSource",
      "type": "string"
    },
    "MCPConnectionTransport": {
      "enum": [
        "streamable_http",
        "legacy_sse",
        "websocket",
        "stdio"
      ],
      "title": "MCPConnectionTransport",
      "type": "string"
    },
    "MCPCredentialInjectionV1": {
      "additionalProperties": false,
      "description": "A secret-free credential slot the connection declares.\n\nThe broker fills it from the connection's account link (the connection\nowner's own link first, then the team's; ``AccountLinkV1``), which also\nmakes the connection a tool that needs a linked account in the catalog.\n``owner_scope_kind`` is kept only so installed records keep their digest;\nthe account link, not the slot, decides whose account is used.",
      "properties": {
        "field_name": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Field Name",
          "type": "string"
        },
        "owner_scope_kind": {
          "default": "team",
          "enum": [
            "user",
            "team"
          ],
          "title": "Owner Scope Kind",
          "type": "string"
        },
        "target_kind": {
          "enum": [
            "header",
            "env"
          ],
          "title": "Target Kind",
          "type": "string"
        },
        "target_name": {
          "maxLength": 240,
          "minLength": 1,
          "title": "Target Name",
          "type": "string"
        },
        "template": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Template"
        }
      },
      "required": [
        "target_kind",
        "target_name",
        "field_name"
      ],
      "title": "MCPCredentialInjectionV1",
      "type": "object"
    },
    "MCPOperationDefinitionV1": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "default": "",
          "maxLength": 4000,
          "title": "Description",
          "type": "string"
        },
        "input_schema": {
          "additionalProperties": true,
          "title": "Input Schema",
          "type": "object"
        },
        "operation_digest": {
          "default": "",
          "title": "Operation Digest",
          "type": "string"
        },
        "operation_name": {
          "title": "Operation Name",
          "type": "string"
        },
        "output_schema": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Schema"
        },
        "schema_version": {
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "operation_name",
        "input_schema"
      ],
      "title": "MCPOperationDefinitionV1",
      "type": "object"
    }
  },
  "$id": "https://universal-agents.dev/schemas/team-transfer/v1/MCPConnectionRecordV1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "approval": {
      "anyOf": [
        {
          "$ref": "#/$defs/ChangeApprovalRecordV1"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "connection_id": {
      "title": "Connection Id",
      "type": "string"
    },
    "created_at_utc": {
      "format": "date-time",
      "title": "Created At Utc",
      "type": "string"
    },
    "descriptor": {
      "$ref": "#/$defs/MCPConnectionDescriptorV1"
    },
    "drift_reason": {
      "anyOf": [
        {
          "maxLength": 2000,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Drift Reason"
    },
    "lifecycle": {
      "$ref": "#/$defs/MCPConnectionLifecycle"
    },
    "operation_catalog_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Operation Catalog Sha256"
    },
    "operations": {
      "default": [],
      "items": {
        "$ref": "#/$defs/MCPOperationDefinitionV1"
      },
      "title": "Operations",
      "type": "array"
    },
    "record_digest": {
      "default": "",
      "title": "Record Digest",
      "type": "string"
    },
    "rejection_reason": {
      "anyOf": [
        {
          "maxLength": 2000,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Rejection Reason"
    },
    "schema_version": {
      "const": 2,
      "default": 2,
      "title": "Schema Version",
      "type": "integer"
    },
    "target_agent_types": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Target Agent Types",
      "type": "array"
    },
    "updated_at_utc": {
      "format": "date-time",
      "title": "Updated At Utc",
      "type": "string"
    }
  },
  "required": [
    "connection_id",
    "descriptor",
    "lifecycle",
    "created_at_utc",
    "updated_at_utc"
  ],
  "title": "MCPConnectionRecordV1",
  "type": "object"
}
