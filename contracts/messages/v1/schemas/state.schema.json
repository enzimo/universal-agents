{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://universal-agents.local/contracts/messages/v1/schemas/state.schema.json",
  "title": "Signed state record of protocol 1",
  "description": "Every key-value record is one state record, signed with Ed25519 over the domain prefix universal-agents/state-record/v1 and a newline, then the RFC 8785 canonical JSON of the record without its signature. The registry names, per record, who signs it and the schema its body follows. Readers verify every record they use; where it is stored adds no trust.",
  "type": "object",
  "properties": {
    "record": {
      "type": "string",
      "enum": [
        "agent_session",
        "agreement",
        "certificate",
        "revocations"
      ]
    },
    "key": {
      "$ref": "common.schema.json#/$defs/state_key"
    },
    "writer": {
      "$ref": "common.schema.json#/$defs/state_writer"
    },
    "sequence": {
      "$ref": "common.schema.json#/$defs/state_sequence"
    },
    "issued_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "expires_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "algorithm": {
      "const": "ed25519"
    },
    "body_digest": {
      "description": "SHA-256 of the RFC 8785 canonical JSON of the body.",
      "$ref": "common.schema.json#/$defs/sha256_digest"
    },
    "body": {
      "type": "object"
    },
    "signature": {
      "$ref": "common.schema.json#/$defs/ed25519_signature"
    }
  },
  "required": [
    "record",
    "key",
    "writer",
    "sequence",
    "issued_at",
    "algorithm",
    "body_digest",
    "body",
    "signature"
  ],
  "additionalProperties": false
}
