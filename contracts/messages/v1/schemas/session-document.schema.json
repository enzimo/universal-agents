{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://universal-agents.local/contracts/messages/v1/schemas/session-document.schema.json",
  "title": "Signed agent session certificate of protocol 1",
  "description": "The signed state document returned by sessions.open and sessions.renew. Its record is agent_session, its writer the team services host that placed the agent, and its body an agent session. The host that asked verifies its signature with that host's certificate and checks that it places the agent it asked for on itself (README, \"Agent sessions\").",
  "type": "object",
  "properties": {
    "record": {
      "const": "agent_session"
    },
    "protocol": {
      "description": "The writer's protocol label (README, \"Versions\").",
      "$ref": "common.schema.json#/$defs/protocol_label"
    },
    "key": {
      "$ref": "common.schema.json#/$defs/state_key"
    },
    "writer": {
      "description": "Only a team services host signs a session.",
      "type": "object",
      "properties": {
        "type": {
          "const": "host"
        },
        "installation": {
          "$ref": "common.schema.json#/$defs/installation_id"
        },
        "runtime": {
          "$ref": "common.schema.json#/$defs/runtime_id"
        },
        "membership_epoch": {
          "$ref": "common.schema.json#/$defs/epoch"
        },
        "key_id": {
          "$ref": "common.schema.json#/$defs/key_id"
        }
      },
      "required": [
        "type",
        "installation",
        "runtime",
        "membership_epoch",
        "key_id"
      ],
      "additionalProperties": false
    },
    "sequence": {
      "$ref": "common.schema.json#/$defs/state_sequence"
    },
    "issued_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "expires_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "algorithm": {
      "const": "ed25519"
    },
    "body_digest": {
      "$ref": "common.schema.json#/$defs/sha256_digest"
    },
    "body": {
      "$ref": "state/agent_session.schema.json"
    },
    "signature": {
      "$ref": "common.schema.json#/$defs/ed25519_signature"
    }
  },
  "required": [
    "record",
    "protocol",
    "key",
    "writer",
    "sequence",
    "issued_at",
    "algorithm",
    "body_digest",
    "body",
    "signature"
  ],
  "additionalProperties": false
}
