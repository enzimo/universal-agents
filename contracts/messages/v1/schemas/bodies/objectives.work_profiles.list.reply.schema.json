{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://universal-agents.local/contracts/messages/v1/schemas/bodies/objectives.work_profiles.list.reply.schema.json",
  "title": "objectives.work_profiles.list.reply",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "outcome": {
          "const": "ok"
        },
        "catalog": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "type": {
                  "const": "inline"
                },
                "value": {
                  "$ref": "#/$defs/profile_catalog"
                }
              },
              "required": [
                "type",
                "value"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "const": "blob"
                },
                "ref": {
                  "$ref": "../common.schema.json#/$defs/blob_ref"
                }
              },
              "required": [
                "type",
                "ref"
              ],
              "additionalProperties": false
            }
          ]
        }
      },
      "required": [
        "outcome",
        "catalog"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "outcome": {
          "const": "feature_off"
        },
        "message": {
          "$ref": "../common.schema.json#/$defs/short_text"
        }
      },
      "required": [
        "outcome"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "outcome": {
          "const": "invalid_request"
        },
        "message": {
          "$ref": "../common.schema.json#/$defs/short_text"
        }
      },
      "required": [
        "outcome"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "outcome": {
          "const": "runtime_error"
        },
        "message": {
          "$ref": "../common.schema.json#/$defs/short_text"
        }
      },
      "required": [
        "outcome"
      ],
      "additionalProperties": false
    }
  ],
  "$defs": {
    "profile_catalog": {
      "type": "object",
      "properties": {
        "profiles": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "profile_name": {
                    "type": "string",
                    "minLength": 0,
                    "maxLength": 16384
                  },
                  "profile_source": {
                    "const": "configured"
                  },
                  "profile": {
                    "$ref": "objectives.work_profiles.apply.reply.schema.json#/$defs/objective_profile_proposal/properties/profile"
                  }
                },
                "required": [
                  "profile_name",
                  "profile_source",
                  "profile"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "schema_version": {
                    "const": 1
                  },
                  "installed_profile_id": {
                    "$ref": "../common.schema.json#/$defs/record_id"
                  },
                  "owner_agent_id": {
                    "$ref": "../common.schema.json#/$defs/durable_owner_id"
                  },
                  "owner_person": {
                    "$ref": "../common.schema.json#/$defs/person_ref"
                  },
                  "profile_name": {
                    "type": "string",
                    "minLength": 0,
                    "maxLength": 16384
                  },
                  "profile": {
                    "type": "object",
                    "properties": {
                      "cadence_cron": {
                        "type": "string",
                        "minLength": 0,
                        "maxLength": 16384
                      },
                      "cadence_timezone": {
                        "type": "string",
                        "minLength": 0,
                        "maxLength": 16384
                      },
                      "budget": {
                        "type": "object",
                        "properties": {
                          "active_seconds": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 9007199254740991
                          },
                          "checkpoint_reserve_seconds": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 9007199254740991
                          },
                          "checkpoint_reserve_turns": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 9007199254740991
                          },
                          "checkpoint_reserve_tokens": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 9007199254740991
                          },
                          "checkpoint_reserve_tool_calls": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 9007199254740991
                          },
                          "turns": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 9007199254740991
                          },
                          "total_tokens": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 9007199254740991
                          },
                          "tool_calls": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 9007199254740991
                          }
                        },
                        "required": [
                          "active_seconds",
                          "checkpoint_reserve_seconds",
                          "checkpoint_reserve_turns",
                          "checkpoint_reserve_tokens",
                          "checkpoint_reserve_tool_calls",
                          "turns",
                          "total_tokens",
                          "tool_calls"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "required": [
                      "cadence_cron",
                      "cadence_timezone",
                      "budget"
                    ],
                    "additionalProperties": false
                  },
                  "source_proposal_id": {
                    "$ref": "../common.schema.json#/$defs/record_id"
                  },
                  "proposal_digest": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "installed_by_task_id": {
                    "$ref": "../common.schema.json#/$defs/record_id"
                  },
                  "acceptance_summary": {
                    "$ref": "../common.schema.json#/$defs/text_content"
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "active",
                      "removed"
                    ]
                  },
                  "created_at": {
                    "$ref": "../common.schema.json#/$defs/timestamp"
                  },
                  "updated_at": {
                    "$ref": "../common.schema.json#/$defs/timestamp"
                  },
                  "profile_source": {
                    "const": "installed"
                  }
                },
                "required": [
                  "schema_version",
                  "installed_profile_id",
                  "owner_agent_id",
                  "owner_person",
                  "profile_name",
                  "profile",
                  "source_proposal_id",
                  "proposal_digest",
                  "installed_by_task_id",
                  "acceptance_summary",
                  "status",
                  "created_at",
                  "updated_at",
                  "profile_source"
                ],
                "additionalProperties": false
              }
            ]
          },
          "minItems": 0,
          "maxItems": 1500
        },
        "default_profile": {
          "type": "string",
          "minLength": 0,
          "maxLength": 16384
        },
        "custom_profile_limits": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "allow_reusable_installation": {
              "type": "boolean"
            },
            "proposal_ttl_seconds": {
              "type": "integer",
              "minimum": 300,
              "maximum": 604800
            },
            "minimum_cadence_interval_seconds": {
              "type": "integer",
              "minimum": 60,
              "maximum": 604800
            },
            "max_installed_profiles_per_owner": {
              "type": "integer",
              "minimum": 1,
              "maximum": 500
            },
            "budget_bounds": {
              "type": "object",
              "properties": {
                "minimum": {
                  "$ref": "objectives.work_profiles.apply.reply.schema.json#/$defs/objective_profile_proposal/properties/profile/properties/budget"
                },
                "maximum": {
                  "$ref": "objectives.work_profiles.apply.reply.schema.json#/$defs/objective_profile_proposal/properties/profile/properties/budget"
                }
              },
              "required": [
                "minimum",
                "maximum"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "enabled",
            "allow_reusable_installation",
            "proposal_ttl_seconds",
            "minimum_cadence_interval_seconds",
            "max_installed_profiles_per_owner",
            "budget_bounds"
          ],
          "additionalProperties": false
        },
        "proposals": {
          "type": "array",
          "items": {
            "$ref": "objectives.work_profiles.apply.reply.schema.json#/$defs/objective_profile_proposal"
          },
          "minItems": 0,
          "maxItems": 50
        }
      },
      "required": [
        "profiles",
        "default_profile",
        "custom_profile_limits"
      ],
      "additionalProperties": false
    }
  }
}
