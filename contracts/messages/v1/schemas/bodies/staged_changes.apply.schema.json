{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://universal-agents.local/contracts/messages/v1/schemas/bodies/staged_changes.apply.schema.json",
  "title": "staged_changes.apply request",
  "description": "The lead applies a staged change the person reviewed.",
  "type": "object",
  "properties": {
    "request_id": {
      "$ref": "../common.schema.json#/$defs/record_id"
    },
    "change_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "seen_version": {
      "$ref": "../common.schema.json#/$defs/record_version",
      "description": "The staged plan_digest returned by the staging tool. A changed digest requires a newly reviewed plan."
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "confirmed": {
      "type": "boolean"
    }
  },
  "required": [
    "request_id",
    "change_id",
    "seen_version",
    "reason",
    "confirmed"
  ],
  "additionalProperties": false
}
