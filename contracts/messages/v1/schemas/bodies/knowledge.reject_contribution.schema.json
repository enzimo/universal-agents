{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://universal-agents.local/contracts/messages/v1/schemas/bodies/knowledge.reject_contribution.schema.json",
  "title": "knowledge.reject_contribution request",
  "description": "A curator rejects a contribution.",
  "type": "object",
  "properties": {
    "request_id": {
      "$ref": "../common.schema.json#/$defs/record_id"
    },
    "contribution_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32768
    }
  },
  "required": [
    "request_id",
    "contribution_id",
    "reason"
  ],
  "additionalProperties": false
}
