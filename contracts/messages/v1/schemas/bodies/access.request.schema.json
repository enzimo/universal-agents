{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://universal-agents.local/contracts/messages/v1/schemas/bodies/access.request.schema.json",
  "title": "access.request body",
  "description": "A task asks the team services for access; no model decides it.",
  "type": "object",
  "properties": {
    "request_id": {
      "$ref": "../common.schema.json#/$defs/record_id"
    },
    "task_id": {
      "$ref": "../common.schema.json#/$defs/record_id"
    },
    "reason": {
      "$ref": "../common.schema.json#/$defs/note_text"
    },
    "what": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "access"
            },
            "target": {
              "$ref": "../common.schema.json#/$defs/access_target"
            },
            "level": {
              "type": "string",
              "enum": [
                "read",
                "write",
                "full"
              ]
            },
            "lifetime": {
              "type": "string",
              "enum": [
                "one_time",
                "task",
                "until",
                "until_revoked"
              ]
            },
            "hours": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2160
            },
            "hand_on": {
              "type": "boolean"
            },
            "action_digest": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,128}$"
            }
          },
          "required": [
            "type",
            "target",
            "level",
            "lifetime",
            "hand_on"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "change"
            },
            "change_kind": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "change_id": {
              "$ref": "../common.schema.json#/$defs/record_id"
            },
            "plan_digest": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,128}$"
            }
          },
          "required": [
            "type",
            "change_kind",
            "change_id",
            "plan_digest"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": [
    "request_id",
    "task_id",
    "reason",
    "what"
  ],
  "additionalProperties": false
}
