{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://universal-agents.local/contracts/messages/v1/schemas/bodies/tasks.cancel.schema.json",
  "title": "tasks.cancel request",
  "description": "Stop a task, a conversation's work, a delivery's work or all of the person's work.",
  "type": "object",
  "properties": {
    "request_id": {
      "$ref": "../common.schema.json#/$defs/record_id"
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "selector": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "by": {
              "const": "task"
            },
            "task_id": {
              "$ref": "../common.schema.json#/$defs/record_id"
            }
          },
          "required": [
            "by",
            "task_id"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "by": {
              "const": "conversation"
            },
            "conversation_id": {
              "$ref": "../common.schema.json#/$defs/record_id"
            }
          },
          "required": [
            "by",
            "conversation_id"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "by": {
              "const": "delivery"
            },
            "delivery_ref": {
              "$ref": "../common.schema.json#/$defs/delivery_ref"
            }
          },
          "required": [
            "by",
            "delivery_ref"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "by": {
              "const": "all"
            }
          },
          "required": [
            "by"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": [
    "request_id",
    "selector"
  ],
  "additionalProperties": false
}
