{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://universal-agents.local/contracts/messages/v1/schemas/bodies/knowledge.archive.schema.json",
  "title": "knowledge.archive request",
  "description": "Archive a knowledge page.",
  "type": "object",
  "properties": {
    "request_id": {
      "$ref": "../common.schema.json#/$defs/record_id"
    },
    "space": {
      "type": "string",
      "enum": [
        "team",
        "personal"
      ]
    },
    "page": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "seen_version": {
      "$ref": "../common.schema.json#/$defs/record_version"
    },
    "reason": {
      "$ref": "../common.schema.json#/$defs/short_text"
    }
  },
  "required": [
    "request_id",
    "space",
    "page",
    "seen_version",
    "reason"
  ],
  "additionalProperties": false
}
