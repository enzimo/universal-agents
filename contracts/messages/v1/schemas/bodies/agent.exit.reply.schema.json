{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://universal-agents.local/contracts/messages/v1/schemas/bodies/agent.exit.reply.schema.json",
  "title": "agent.exit reply",
  "description": "Stop an agent after its current step.",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "outcome": {
          "const": "ok"
        },
        "state": {
          "type": "string",
          "enum": [
            "exiting",
            "already_exiting"
          ]
        }
      },
      "required": [
        "outcome",
        "state"
      ],
      "additionalProperties": false
    }
  ]
}
