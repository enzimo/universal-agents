{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://universal-agents.local/contracts/messages/v1/schemas/bodies/knowledge.list_contributions.reply.schema.json",
  "title": "knowledge.list_contributions reply",
  "description": "Contributions waiting for a curator.",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "outcome": {
          "const": "ok"
        },
        "contributions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "contribution_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240
              },
              "page": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              },
              "state": {
                "type": "string",
                "enum": [
                  "pending",
                  "published",
                  "withdrawn",
                  "rejected"
                ]
              },
              "seen_version": {
                "$ref": "../common.schema.json#/$defs/record_version"
              },
              "created_at": {
                "$ref": "../common.schema.json#/$defs/timestamp"
              },
              "author": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "const": "agent"
                      },
                      "agent_type": {
                        "$ref": "../common.schema.json#/$defs/agent_type"
                      }
                    },
                    "required": [
                      "kind",
                      "agent_type"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "const": "person"
                      },
                      "person": {
                        "$ref": "../common.schema.json#/$defs/person_ref"
                      }
                    },
                    "required": [
                      "kind",
                      "person"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "const": "system"
                      }
                    },
                    "required": [
                      "kind"
                    ],
                    "additionalProperties": false
                  }
                ]
              }
            },
            "required": [
              "contribution_id",
              "title",
              "state",
              "seen_version",
              "created_at",
              "author"
            ],
            "additionalProperties": false
          },
          "maxItems": 20
        },
        "total": {
          "$ref": "../common.schema.json#/$defs/count"
        }
      },
      "required": [
        "outcome",
        "contributions",
        "total"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "outcome": {
          "const": "not_allowed"
        },
        "message": {
          "$ref": "../common.schema.json#/$defs/short_text"
        }
      },
      "required": [
        "outcome"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "outcome": {
          "const": "feature_off"
        },
        "message": {
          "$ref": "../common.schema.json#/$defs/short_text"
        }
      },
      "required": [
        "outcome"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "outcome": {
          "const": "runtime_error"
        },
        "message": {
          "$ref": "../common.schema.json#/$defs/short_text"
        }
      },
      "required": [
        "outcome"
      ],
      "additionalProperties": false
    }
  ]
}
