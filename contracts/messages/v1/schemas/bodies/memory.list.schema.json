{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://universal-agents.local/contracts/messages/v1/schemas/bodies/memory.list.schema.json",
  "title": "memory.list request",
  "description": "List a memory bank's facts.",
  "type": "object",
  "properties": {
    "request_id": {
      "$ref": "../common.schema.json#/$defs/record_id"
    },
    "bank": {
      "type": "string",
      "enum": [
        "coremem",
        "usermem"
      ]
    },
    "sort": {
      "type": "string",
      "enum": [
        "memory_id",
        "newest",
        "valid_from",
        "expires"
      ],
      "description": "memory_id ascending; newest by update time then id descending; valid_from ascending then id; expires ascending then id, with no expiry last."
    },
    "offset": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    }
  },
  "required": [
    "request_id",
    "bank",
    "sort",
    "offset",
    "limit"
  ],
  "additionalProperties": false
}
