{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://universal-agents.local/contracts/messages/v1/schemas/bodies/schedules.set_worker.reply.schema.json",
  "title": "schedules.set_worker reply",
  "description": "Choose which worker runs a schedule.",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "outcome": {
          "const": "ok"
        },
        "state": {
          "const": "applied"
        },
        "schedule_id": {
          "$ref": "../common.schema.json#/$defs/record_id"
        },
        "policy_revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "pending_current_claim": {
          "type": "boolean"
        },
        "enabled": {
          "type": "boolean"
        },
        "automation_enabled": {
          "type": "boolean"
        },
        "worker_policy": {
          "$ref": "schedules.set_worker.schema.json#/$defs/schedule_worker_policy"
        },
        "saved_requirements": {
          "$ref": "schedules.set_worker.schema.json#/$defs/schedule_worker_capabilities"
        },
        "readiness": {
          "$ref": "schedules.set_worker.schema.json#/$defs/schedule_worker_readiness"
        },
        "missing_access": {
          "type": "array",
          "items": {
            "$ref": "schedules.set_worker.schema.json#/$defs/schedule_worker_missing_access"
          },
          "maxItems": 64
        },
        "summary": {
          "$ref": "../common.schema.json#/$defs/text_content"
        },
        "version": {
          "$ref": "schedules.update.reply.schema.json#/$defs/saved_schedule_version"
        },
        "warnings": {
          "$ref": "../common.schema.json#/$defs/text_content"
        }
      },
      "required": [
        "outcome",
        "state",
        "schedule_id",
        "policy_revision",
        "pending_current_claim",
        "enabled",
        "automation_enabled",
        "worker_policy",
        "saved_requirements",
        "readiness",
        "missing_access",
        "summary",
        "version"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "outcome": {
          "const": "approval_required"
        },
        "change_id": {
          "$ref": "../common.schema.json#/$defs/record_id"
        },
        "message": {
          "$ref": "../common.schema.json#/$defs/short_text"
        }
      },
      "required": [
        "outcome",
        "change_id"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "outcome": {
          "const": "not_found"
        },
        "message": {
          "$ref": "../common.schema.json#/$defs/short_text"
        }
      },
      "required": [
        "outcome"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "outcome": {
          "const": "not_allowed"
        },
        "message": {
          "$ref": "../common.schema.json#/$defs/short_text"
        }
      },
      "required": [
        "outcome"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "outcome": {
          "const": "changed_since_read"
        },
        "current_version": {
          "$ref": "../common.schema.json#/$defs/record_version"
        },
        "message": {
          "$ref": "../common.schema.json#/$defs/short_text"
        }
      },
      "required": [
        "outcome",
        "current_version"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "outcome": {
          "const": "change_conflict"
        },
        "case_id": {
          "$ref": "../common.schema.json#/$defs/record_id"
        },
        "brief": {
          "$ref": "../common.schema.json#/$defs/blob_ref"
        },
        "message": {
          "$ref": "../common.schema.json#/$defs/short_text"
        }
      },
      "required": [
        "outcome",
        "case_id",
        "brief"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "outcome": {
          "const": "request_closed"
        },
        "request_state": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "message": {
          "$ref": "../common.schema.json#/$defs/short_text"
        }
      },
      "required": [
        "outcome"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "outcome": {
          "const": "needs_person_decision"
        },
        "case_id": {
          "$ref": "../common.schema.json#/$defs/record_id"
        },
        "message": {
          "$ref": "../common.schema.json#/$defs/short_text"
        }
      },
      "required": [
        "outcome"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "outcome": {
          "const": "record_busy"
        },
        "retry_at": {
          "$ref": "../common.schema.json#/$defs/timestamp"
        },
        "message": {
          "$ref": "../common.schema.json#/$defs/short_text"
        }
      },
      "required": [
        "outcome",
        "retry_at"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "outcome": {
          "const": "runtime_error"
        },
        "message": {
          "$ref": "../common.schema.json#/$defs/short_text"
        }
      },
      "required": [
        "outcome"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "outcome": {
          "const": "invalid_request"
        },
        "reason": {
          "type": "string",
          "minLength": 0,
          "maxLength": 4096
        },
        "message": {
          "$ref": "../common.schema.json#/$defs/short_text"
        }
      },
      "required": [
        "outcome",
        "reason"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "outcome": {
          "const": "schedule_worker_policy_revision_conflict"
        },
        "current_policy_revision": {
          "$ref": "../common.schema.json#/$defs/count"
        },
        "message": {
          "$ref": "../common.schema.json#/$defs/short_text"
        }
      },
      "required": [
        "outcome",
        "current_policy_revision"
      ],
      "additionalProperties": false
    }
  ]
}
