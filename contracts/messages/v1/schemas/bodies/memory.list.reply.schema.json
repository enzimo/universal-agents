{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://universal-agents.local/contracts/messages/v1/schemas/bodies/memory.list.reply.schema.json",
  "title": "memory.list reply",
  "description": "List a memory bank's facts.",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "outcome": {
          "const": "ok"
        },
        "facts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "memory_id": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "fact_text": {
                "$ref": "../common.schema.json#/$defs/text_content"
              },
              "valid_from": {
                "$ref": "../common.schema.json#/$defs/timestamp"
              },
              "expires": {
                "$ref": "../common.schema.json#/$defs/timestamp"
              },
              "tags": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "maxItems": 100
              },
              "created_at": {
                "$ref": "../common.schema.json#/$defs/timestamp"
              },
              "updated_at": {
                "$ref": "../common.schema.json#/$defs/timestamp"
              },
              "seen_version": {
                "$ref": "../common.schema.json#/$defs/record_version"
              },
              "metadata_json": {
                "type": "string",
                "minLength": 2,
                "maxLength": 16384,
                "description": "JSON text encoding a metadata object. Apply the bank's max_metadata_chars and exclude reserved import provenance from public replies."
              }
            },
            "required": [
              "memory_id",
              "fact_text",
              "tags",
              "created_at",
              "updated_at",
              "seen_version"
            ],
            "additionalProperties": false
          },
          "maxItems": 100
        },
        "total": {
          "$ref": "../common.schema.json#/$defs/count"
        },
        "next_offset": {
          "$ref": "../common.schema.json#/$defs/count",
          "description": "Continue from this zero-based row offset. Present only while more facts remain."
        }
      },
      "required": [
        "outcome",
        "facts",
        "total"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "outcome": {
          "const": "not_allowed"
        },
        "message": {
          "$ref": "../common.schema.json#/$defs/short_text"
        }
      },
      "required": [
        "outcome"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "outcome": {
          "const": "runtime_error"
        },
        "message": {
          "$ref": "../common.schema.json#/$defs/short_text"
        }
      },
      "required": [
        "outcome"
      ],
      "additionalProperties": false
    }
  ]
}
