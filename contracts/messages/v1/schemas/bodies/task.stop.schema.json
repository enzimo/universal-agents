{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://universal-agents.local/contracts/messages/v1/schemas/bodies/task.stop.schema.json",
  "title": "task.stop body",
  "description": "Stop one task. The holder stops at its next safe point, never in the middle of an outward action.",
  "type": "object",
  "properties": {
    "task_id": {
      "$ref": "../common.schema.json#/$defs/record_id"
    },
    "stop_id": {
      "$ref": "../common.schema.json#/$defs/record_id"
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "cascade_to_subtasks": {
      "type": "boolean"
    }
  },
  "required": [
    "task_id",
    "stop_id",
    "cascade_to_subtasks"
  ],
  "additionalProperties": false
}
