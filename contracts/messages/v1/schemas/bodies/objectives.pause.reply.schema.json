{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://universal-agents.local/contracts/messages/v1/schemas/bodies/objectives.pause.reply.schema.json",
  "title": "objectives.pause reply",
  "description": "Pause one of the person's Objectives.",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "outcome": {
          "const": "ok"
        },
        "objective_id": {
          "$ref": "../common.schema.json#/$defs/record_id"
        },
        "status": {
          "type": "string",
          "enum": [
            "proposed",
            "active",
            "paused",
            "blocked",
            "satisfied",
            "failed",
            "cancelled",
            "abandoned",
            "deleting",
            "deleted"
          ]
        },
        "seen_version": {
          "$ref": "../common.schema.json#/$defs/record_version"
        },
        "incomplete": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "part": {
                "type": "string",
                "enum": [
                  "schedule",
                  "heartbeat",
                  "policy",
                  "task",
                  "objective"
                ]
              },
              "id": {
                "$ref": "../common.schema.json#/$defs/record_id"
              }
            },
            "required": [
              "part",
              "id"
            ],
            "additionalProperties": false
          },
          "maxItems": 50
        },
        "receipts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "root_task_id": {
                "$ref": "../common.schema.json#/$defs/record_id"
              },
              "cancelled_task_count": {
                "$ref": "../common.schema.json#/$defs/count"
              },
              "stop_signals_sent": {
                "$ref": "../common.schema.json#/$defs/count"
              },
              "unconfirmed_worker_count": {
                "$ref": "../common.schema.json#/$defs/count"
              },
              "state": {
                "type": "string",
                "enum": [
                  "confirmed",
                  "barrier_not_saved",
                  "failed"
                ]
              }
            },
            "required": [
              "root_task_id",
              "cancelled_task_count",
              "stop_signals_sent",
              "unconfirmed_worker_count",
              "state"
            ],
            "additionalProperties": false
          },
          "maxItems": 50
        }
      },
      "required": [
        "outcome",
        "objective_id",
        "status",
        "seen_version",
        "incomplete",
        "receipts"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "outcome": {
          "const": "not_found"
        },
        "message": {
          "$ref": "../common.schema.json#/$defs/short_text"
        }
      },
      "required": [
        "outcome"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "outcome": {
          "const": "not_allowed"
        },
        "message": {
          "$ref": "../common.schema.json#/$defs/short_text"
        }
      },
      "required": [
        "outcome"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "outcome": {
          "const": "changed_since_read"
        },
        "current_version": {
          "$ref": "../common.schema.json#/$defs/record_version"
        },
        "message": {
          "$ref": "../common.schema.json#/$defs/short_text"
        }
      },
      "required": [
        "outcome"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "outcome": {
          "const": "action_unavailable"
        },
        "current_status": {
          "type": "string",
          "enum": [
            "proposed",
            "active",
            "paused",
            "blocked",
            "satisfied",
            "failed",
            "cancelled",
            "abandoned",
            "deleting",
            "deleted"
          ]
        },
        "message": {
          "$ref": "../common.schema.json#/$defs/short_text"
        }
      },
      "required": [
        "outcome",
        "current_status"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "outcome": {
          "const": "runtime_error"
        },
        "message": {
          "$ref": "../common.schema.json#/$defs/short_text"
        }
      },
      "required": [
        "outcome"
      ],
      "additionalProperties": false
    }
  ]
}
