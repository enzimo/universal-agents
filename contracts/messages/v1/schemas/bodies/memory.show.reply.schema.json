{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://universal-agents.local/contracts/messages/v1/schemas/bodies/memory.show.reply.schema.json",
  "title": "memory.show reply",
  "description": "Show one memory fact.",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "outcome": {
          "const": "ok"
        },
        "fact": {
          "type": "object",
          "properties": {
            "memory_id": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "fact_text": {
              "type": "string",
              "minLength": 1,
              "maxLength": 12000
            },
            "valid_from": {
              "$ref": "../common.schema.json#/$defs/timestamp"
            },
            "expires": {
              "$ref": "../common.schema.json#/$defs/timestamp"
            },
            "tags": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "maxItems": 20
            },
            "created_at": {
              "$ref": "../common.schema.json#/$defs/timestamp"
            },
            "updated_at": {
              "$ref": "../common.schema.json#/$defs/timestamp"
            },
            "seen_version": {
              "$ref": "../common.schema.json#/$defs/record_version"
            }
          },
          "required": [
            "memory_id",
            "fact_text",
            "tags",
            "created_at",
            "updated_at",
            "seen_version"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "outcome",
        "fact"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "outcome": {
          "const": "not_allowed"
        },
        "message": {
          "$ref": "../common.schema.json#/$defs/short_text"
        }
      },
      "required": [
        "outcome"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "outcome": {
          "const": "not_found"
        },
        "message": {
          "$ref": "../common.schema.json#/$defs/short_text"
        }
      },
      "required": [
        "outcome"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "outcome": {
          "const": "runtime_error"
        },
        "message": {
          "$ref": "../common.schema.json#/$defs/short_text"
        }
      },
      "required": [
        "outcome"
      ],
      "additionalProperties": false
    }
  ]
}
