{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://universal-agents.local/contracts/messages/v1/schemas/bodies/schedules.list.reply.schema.json",
  "title": "schedules.list reply",
  "description": "The schedules the caller may see.",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "outcome": {
          "const": "ok"
        },
        "schedules": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "schedule_id": {
                "$ref": "../common.schema.json#/$defs/record_id"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              "management_class": {
                "type": "string",
                "enum": [
                  "user",
                  "system"
                ]
              },
              "system_schedule_kind": {
                "type": "string",
                "enum": [
                  "unclassified",
                  "heartbeat_launcher",
                  "memory_review_coremem",
                  "memory_review_usermem",
                  "memory_review_stale_conversations",
                  "internal_improvement",
                  "after_action_report_review",
                  "delegation_assurance",
                  "isolated_recovery_checkpoint",
                  "provider_overload_retry",
                  "objective_work_session",
                  "knowledge_curation_person",
                  "knowledge_curation_team"
                ]
              },
              "objective_id": {
                "$ref": "../common.schema.json#/$defs/record_id"
              },
              "instruction_preview": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              "timing": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "const": "interval"
                      },
                      "interval_ms": {
                        "type": "integer",
                        "minimum": 1000,
                        "maximum": 31536000000
                      }
                    },
                    "required": [
                      "kind",
                      "interval_ms"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "const": "cron"
                      },
                      "expression": {
                        "type": "string",
                        "pattern": "^[0-9*/,? A-Za-z-]{9,120}$"
                      },
                      "time_zone": {
                        "$ref": "../common.schema.json#/$defs/time_zone"
                      }
                    },
                    "required": [
                      "kind",
                      "expression",
                      "time_zone"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "const": "once"
                      },
                      "at": {
                        "$ref": "../common.schema.json#/$defs/timestamp"
                      }
                    },
                    "required": [
                      "kind",
                      "at"
                    ],
                    "additionalProperties": false
                  }
                ]
              },
              "next_fire_at": {
                "$ref": "../common.schema.json#/$defs/timestamp"
              },
              "paused_until": {
                "$ref": "../common.schema.json#/$defs/timestamp"
              },
              "expires_at": {
                "$ref": "../common.schema.json#/$defs/timestamp"
              },
              "enabled": {
                "type": "boolean"
              },
              "timing_revision": {
                "$ref": "../common.schema.json#/$defs/count"
              },
              "seen_version": {
                "$ref": "../common.schema.json#/$defs/record_version"
              },
              "worker": {
                "type": "object",
                "properties": {
                  "agent_type": {
                    "$ref": "../common.schema.json#/$defs/agent_type"
                  },
                  "agent_id": {
                    "$ref": "../common.schema.json#/$defs/agent_id"
                  }
                },
                "required": [
                  "agent_type"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "schedule_id",
              "name",
              "management_class",
              "timing",
              "enabled",
              "timing_revision",
              "seen_version",
              "worker"
            ],
            "additionalProperties": false
          },
          "maxItems": 50
        },
        "total": {
          "$ref": "../common.schema.json#/$defs/count"
        }
      },
      "required": [
        "outcome",
        "schedules",
        "total"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "outcome": {
          "const": "not_allowed"
        },
        "message": {
          "$ref": "../common.schema.json#/$defs/short_text"
        }
      },
      "required": [
        "outcome"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "outcome": {
          "const": "runtime_error"
        },
        "message": {
          "$ref": "../common.schema.json#/$defs/short_text"
        }
      },
      "required": [
        "outcome"
      ],
      "additionalProperties": false
    }
  ]
}
