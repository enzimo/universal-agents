{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://universal-agents.local/contracts/messages/v1/schemas/bodies/credential.form.request.schema.json",
  "title": "credential.form.request body",
  "description": "Ask the gateway to collect, set up or delete a credential through a secure form.",
  "type": "object",
  "properties": {
    "form_id": {
      "$ref": "../common.schema.json#/$defs/record_id"
    },
    "task_id": {
      "$ref": "../common.schema.json#/$defs/record_id"
    },
    "delivery_ref": {
      "$ref": "../common.schema.json#/$defs/delivery_ref"
    },
    "continue_task": {
      "type": "boolean"
    },
    "user_approved": {
      "type": "boolean"
    },
    "flow": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "collect"
            },
            "service_name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "credential_key": {
              "$ref": "../common.schema.json#/$defs/credential_key"
            },
            "display_name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "purpose": {
              "$ref": "../common.schema.json#/$defs/note_text"
            },
            "store_target": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "signup_url": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            },
            "fields": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                  },
                  "required": {
                    "type": "boolean"
                  },
                  "kind": {
                    "type": "string",
                    "enum": [
                      "username",
                      "email",
                      "password",
                      "token",
                      "api_key",
                      "custom"
                    ]
                  },
                  "visibility": {
                    "type": "string",
                    "enum": [
                      "metadata_visible",
                      "secret"
                    ]
                  },
                  "value_source": {
                    "type": "string",
                    "enum": [
                      "user_input",
                      "agent_supplied_metadata",
                      "user_or_agent_supplied_metadata",
                      "store_generated_secret"
                    ]
                  },
                  "value": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1000
                  },
                  "generation_policy": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]{0,63}$"
                  },
                  "label": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "description": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1000
                  },
                  "placeholder": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "form": {
                    "type": "object",
                    "properties": {
                      "input_control": {
                        "type": "string",
                        "enum": [
                          "text",
                          "password",
                          "textarea",
                          "file"
                        ]
                      },
                      "autocomplete": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 64
                      },
                      "accept": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200
                      },
                      "help_text": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 1000
                      }
                    },
                    "required": [
                      "input_control"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "name",
                  "required",
                  "kind",
                  "visibility",
                  "value_source"
                ],
                "additionalProperties": false
              },
              "maxItems": 20,
              "minItems": 1
            }
          },
          "required": [
            "type",
            "service_name",
            "credential_key",
            "purpose",
            "store_target",
            "fields"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "manual_signup"
            },
            "service_name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "credential_key": {
              "$ref": "../common.schema.json#/$defs/credential_key"
            },
            "display_name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "purpose": {
              "$ref": "../common.schema.json#/$defs/note_text"
            },
            "store_target": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "signup_url": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            },
            "fields": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                  },
                  "required": {
                    "type": "boolean"
                  },
                  "kind": {
                    "type": "string",
                    "enum": [
                      "username",
                      "email",
                      "password",
                      "token",
                      "api_key",
                      "custom"
                    ]
                  },
                  "visibility": {
                    "type": "string",
                    "enum": [
                      "metadata_visible",
                      "secret"
                    ]
                  },
                  "value_source": {
                    "type": "string",
                    "enum": [
                      "user_input",
                      "agent_supplied_metadata",
                      "user_or_agent_supplied_metadata",
                      "store_generated_secret"
                    ]
                  },
                  "value": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1000
                  },
                  "generation_policy": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]{0,63}$"
                  },
                  "label": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "description": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1000
                  },
                  "placeholder": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "form": {
                    "type": "object",
                    "properties": {
                      "input_control": {
                        "type": "string",
                        "enum": [
                          "text",
                          "password",
                          "textarea",
                          "file"
                        ]
                      },
                      "autocomplete": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 64
                      },
                      "accept": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200
                      },
                      "help_text": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 1000
                      }
                    },
                    "required": [
                      "input_control"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "name",
                  "required",
                  "kind",
                  "visibility",
                  "value_source"
                ],
                "additionalProperties": false
              },
              "maxItems": 20,
              "minItems": 1
            },
            "automation_steps": {
              "type": "array",
              "items": {
                "$ref": "../common.schema.json#/$defs/short_text"
              },
              "maxItems": 20
            }
          },
          "required": [
            "type",
            "service_name",
            "credential_key",
            "purpose",
            "store_target",
            "signup_url",
            "fields"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "delete"
            },
            "credential_key": {
              "$ref": "../common.schema.json#/$defs/credential_key"
            },
            "service_name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "source": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            "source_item_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "source_item_name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          },
          "required": [
            "type",
            "credential_key",
            "service_name"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": [
    "form_id",
    "task_id",
    "continue_task",
    "user_approved",
    "flow"
  ],
  "additionalProperties": false
}
