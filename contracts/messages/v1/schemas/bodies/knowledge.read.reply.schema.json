    "contribution_summary": {
      "type": "object",
      "properties": {
        "contribution_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "kind": {
          "type": "string",
          "enum": [
            "create",
            "edit",
            "note",
            "archive"
          ]
        },
        "page": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "title": {
          "type": "string",
          "minLength": 1,
