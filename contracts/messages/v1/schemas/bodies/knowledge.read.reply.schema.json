        "summary": {
          "type": "string",
          "minLength": 0,
          "maxLength": 4000
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "maxItems": 100
        },
        "content": {
          "$ref": "../common.schema.json#/$defs/text_content"
        },
        "change_summary": {
          "type": "string",
          "minLength": 0,
          "maxLength": 4000
        },
        "base_revision": {
          "$ref": "../common.schema.json#/$defs/count"
        },
        "state": {
          "type": "string",
          "enum": [
            "pending",
            "published",
            "withdrawn",
            "rejected"
          ]
        },
        "created_at": {
          "$ref": "../common.schema.json#/$defs/timestamp"
        },
        "author": {
          "type": "object",
          "properties": {
            "kind": {
              "const": "agent"
            },
            "agent_type": {
              "$ref": "../common.schema.json#/$defs/agent_type"
            }
          },
          "required": [
            "kind",
            "agent_type"
          ],
          "additionalProperties": false
        },
        "review_flags": {
          "type": "array",
          "items": {
            "$ref": "knowledge.read.reply.schema.json#/$defs/review_flag"
          },
          "maxItems": 100
        },
        "current": {
          "$ref": "knowledge.read.reply.schema.json#/$defs/page"
        }
      },
      "required": [
        "contribution_id",
        "kind",
        "page",
        "title",
        "page_type",
        "summary",
        "tags",
        "change_summary",
        "base_revision",
        "state",
        "created_at",
        "author",
        "review_flags"
      ],
      "additionalProperties": false
    },
