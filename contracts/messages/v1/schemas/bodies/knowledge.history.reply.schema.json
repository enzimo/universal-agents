{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://universal-agents.local/contracts/messages/v1/schemas/bodies/knowledge.history.reply.schema.json",
  "title": "knowledge.history reply",
  "description": "A knowledge page's revisions.",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "outcome": {
          "const": "ok"
        },
        "page": {
          "type": "object",
          "properties": {
            "space": {
              "type": "string",
              "enum": [
                "team",
                "personal"
              ]
            },
            "page": {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            },
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            },
            "summary": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000
            },
            "body": {
              "type": "string",
              "minLength": 1,
              "maxLength": 32768
            },
            "body_ref": {
              "$ref": "../common.schema.json#/$defs/blob_ref"
            },
            "tags": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "maxItems": 100
            },
            "status": {
              "type": "string",
              "enum": [
                "active",
                "archived"
              ]
            },
            "seen_version": {
              "$ref": "../common.schema.json#/$defs/record_version"
            },
            "updated_at": {
              "$ref": "../common.schema.json#/$defs/timestamp"
            },
            "updated_by": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "const": "agent"
                    },
                    "agent_type": {
                      "$ref": "../common.schema.json#/$defs/agent_type"
                    }
                  },
                  "required": [
                    "kind",
                    "agent_type"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "const": "person"
                    },
                    "person": {
                      "$ref": "../common.schema.json#/$defs/person_ref"
                    }
                  },
                  "required": [
                    "kind",
                    "person"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "const": "system"
                    }
                  },
                  "required": [
                    "kind"
                  ],
                  "additionalProperties": false
                }
              ]
            }
          },
          "required": [
            "space",
            "page",
            "title",
            "tags",
            "status",
            "seen_version",
            "updated_at",
            "updated_by"
          ],
          "additionalProperties": false
        },
        "revisions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "revision": {
                "$ref": "../common.schema.json#/$defs/count"
              },
              "updated_at": {
                "$ref": "../common.schema.json#/$defs/timestamp"
              },
              "updated_by": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "const": "agent"
                      },
                      "agent_type": {
                        "$ref": "../common.schema.json#/$defs/agent_type"
                      }
                    },
                    "required": [
                      "kind",
                      "agent_type"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "const": "person"
                      },
                      "person": {
                        "$ref": "../common.schema.json#/$defs/person_ref"
                      }
                    },
                    "required": [
                      "kind",
                      "person"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "const": "system"
                      }
                    },
                    "required": [
                      "kind"
                    ],
                    "additionalProperties": false
                  }
                ]
              },
              "change_summary": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              }
            },
            "required": [
              "revision",
              "updated_at",
              "updated_by"
            ],
            "additionalProperties": false
          },
          "maxItems": 50
        },
        "total": {
          "$ref": "../common.schema.json#/$defs/count"
        }
      },
      "required": [
        "outcome",
        "page",
        "revisions",
        "total"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "outcome": {
          "const": "not_found"
        },
        "message": {
          "$ref": "../common.schema.json#/$defs/short_text"
        }
      },
      "required": [
        "outcome"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "outcome": {
          "const": "not_allowed"
        },
        "message": {
          "$ref": "../common.schema.json#/$defs/short_text"
        }
      },
      "required": [
        "outcome"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "outcome": {
          "const": "feature_off"
        },
        "message": {
          "$ref": "../common.schema.json#/$defs/short_text"
        }
      },
      "required": [
        "outcome"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "outcome": {
          "const": "runtime_error"
        },
        "message": {
          "$ref": "../common.schema.json#/$defs/short_text"
        }
      },
      "required": [
        "outcome"
      ],
      "additionalProperties": false
    }
  ]
}
