{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://universal-agents.local/contracts/messages/v1/schemas/bodies/heartbeat_items.add.reply.schema.json",
  "title": "heartbeat_items.add reply",
  "description": "The lead adds a heartbeat item.",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "outcome": {
          "const": "ok"
        },
        "item": {
          "$ref": "heartbeat_items.list.reply.schema.json#/$defs/heartbeat_read_item"
        },
        "warning": {
          "type": "string",
          "enum": [
            "heartbeat_off",
            "launcher_missing"
          ]
        },
        "heartbeat_runtime": {
          "$ref": "heartbeat_items.list.reply.schema.json#/$defs/heartbeat_runtime_state"
        },
        "warning_message": {
          "$ref": "../common.schema.json#/$defs/text_content"
        },
        "warnings": {
          "type": "array",
          "items": {
            "$ref": "../common.schema.json#/$defs/text_content"
          },
          "maxItems": 1000
        }
      },
      "required": [
        "outcome",
        "item"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "outcome": {
          "const": "not_found"
        },
        "message": {
          "$ref": "../common.schema.json#/$defs/short_text"
        }
      },
      "required": [
        "outcome"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "outcome": {
          "const": "objective_link_refused"
        },
        "message": {
          "$ref": "../common.schema.json#/$defs/short_text"
        }
      },
      "required": [
        "outcome"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "outcome": {
          "const": "change_conflict"
        },
        "case_id": {
          "$ref": "../common.schema.json#/$defs/record_id"
        },
        "brief": {
          "$ref": "../common.schema.json#/$defs/blob_ref"
        },
        "message": {
          "$ref": "../common.schema.json#/$defs/short_text"
        }
      },
      "required": [
        "outcome",
        "case_id",
        "brief"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "outcome": {
          "const": "request_closed"
        },
        "request_state": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "message": {
          "$ref": "../common.schema.json#/$defs/short_text"
        }
      },
      "required": [
        "outcome"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "outcome": {
          "const": "needs_person_decision"
        },
        "case_id": {
          "$ref": "../common.schema.json#/$defs/record_id"
        },
        "message": {
          "$ref": "../common.schema.json#/$defs/short_text"
        }
      },
      "required": [
        "outcome"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "outcome": {
          "const": "record_busy"
        },
        "retry_at": {
          "$ref": "../common.schema.json#/$defs/timestamp"
        },
        "message": {
          "$ref": "../common.schema.json#/$defs/short_text"
        }
      },
      "required": [
        "outcome",
        "retry_at"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "outcome": {
          "const": "runtime_error"
        },
        "message": {
          "$ref": "../common.schema.json#/$defs/short_text"
        }
      },
      "required": [
        "outcome"
      ],
      "additionalProperties": false
    }
  ]
}
