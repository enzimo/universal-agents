{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://universal-agents.local/contracts/messages/v1/schemas/bodies/objectives.update_progress.schema.json",
  "title": "objectives.update_progress request",
  "description": "The lead records progress on an Objective.",
  "type": "object",
  "properties": {
    "request_id": {
      "$ref": "../common.schema.json#/$defs/record_id"
    },
    "objective_id": {
      "$ref": "../common.schema.json#/$defs/record_id"
    },
    "seen_version": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "progress_summary": {
      "$ref": "../common.schema.json#/$defs/text_content"
    },
    "current_focus": {
      "$ref": "../common.schema.json#/$defs/text_content"
    },
    "task_id": {
      "$ref": "../common.schema.json#/$defs/record_id"
    },
    "plan_id": {
      "$ref": "../common.schema.json#/$defs/record_id"
    },
    "user_visible": {
      "type": "boolean"
    },
    "criterion_updates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "criterion_id": {
            "$ref": "../common.schema.json#/$defs/record_id"
          },
          "description": {
            "$ref": "../common.schema.json#/$defs/text_content"
          },
          "status": {
            "type": "string",
            "enum": [
              "open",
              "met",
              "failed",
              "dropped"
            ]
          },
          "evidence_summary": {
            "$ref": "../common.schema.json#/$defs/text_content"
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 1000
    }
  },
  "required": [
    "request_id",
    "objective_id",
    "seen_version"
  ],
  "additionalProperties": false
}
