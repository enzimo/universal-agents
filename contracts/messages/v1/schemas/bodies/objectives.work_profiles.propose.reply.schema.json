{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://universal-agents.local/contracts/messages/v1/schemas/bodies/objectives.work_profiles.propose.reply.schema.json",
  "title": "objectives.work_profiles.propose.reply",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "outcome": {
          "const": "ok"
        },
        "proposal": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "type": {
                  "const": "inline"
                },
                "value": {
                  "$ref": "#/$defs/pending_profile_proposal"
                }
              },
              "required": [
                "type",
                "value"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "const": "blob"
                },
                "ref": {
                  "$ref": "../common.schema.json#/$defs/blob_ref"
                }
              },
              "required": [
                "type",
                "ref"
              ],
              "additionalProperties": false
            }
          ]
        }
      },
      "required": [
        "outcome",
        "proposal"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "outcome": {
          "const": "not_found"
        },
        "message": {
          "$ref": "../common.schema.json#/$defs/short_text"
        }
      },
      "required": [
        "outcome"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "outcome": {
          "const": "feature_off"
        },
        "message": {
          "$ref": "../common.schema.json#/$defs/short_text"
        }
      },
      "required": [
        "outcome"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "outcome": {
          "const": "invalid_request"
        },
        "message": {
          "$ref": "../common.schema.json#/$defs/short_text"
        }
      },
      "required": [
        "outcome"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "outcome": {
          "const": "direct_user_request_required"
        },
        "message": {
          "$ref": "../common.schema.json#/$defs/short_text"
        }
      },
      "required": [
        "outcome"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "outcome": {
          "const": "runtime_error"
        },
        "message": {
          "$ref": "../common.schema.json#/$defs/short_text"
        }
      },
      "required": [
        "outcome"
      ],
      "additionalProperties": false
    }
  ],
  "$defs": {
    "pending_profile_proposal": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "proposal_id": {
          "$ref": "../common.schema.json#/$defs/record_id"
        },
        "owner_agent_id": {
          "$ref": "../common.schema.json#/$defs/durable_owner_id"
        },
        "owner_person": {
          "$ref": "../common.schema.json#/$defs/person_ref"
        },
        "source_task_id": {
          "$ref": "../common.schema.json#/$defs/record_id"
        },
        "scope": {
          "type": "string",
          "enum": [
            "objective",
            "reusable"
          ]
        },
        "objective_id": {
          "$ref": "../common.schema.json#/$defs/record_id"
        },
        "profile_name": {
          "type": "string",
          "minLength": 0,
          "maxLength": 16384
        },
        "profile": {
          "type": "object",
          "properties": {
            "cadence_cron": {
              "type": "string",
              "minLength": 0,
              "maxLength": 16384
            },
            "cadence_timezone": {
              "type": "string",
              "minLength": 0,
              "maxLength": 16384
            },
            "budget": {
              "type": "object",
              "properties": {
                "active_seconds": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                },
                "checkpoint_reserve_seconds": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "checkpoint_reserve_turns": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "checkpoint_reserve_tokens": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "checkpoint_reserve_tool_calls": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "turns": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                },
                "total_tokens": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                },
                "tool_calls": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "active_seconds",
                "checkpoint_reserve_seconds",
                "checkpoint_reserve_turns",
                "checkpoint_reserve_tokens",
                "checkpoint_reserve_tool_calls",
                "turns",
                "total_tokens",
                "tool_calls"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "cadence_cron",
            "cadence_timezone",
            "budget"
          ],
          "additionalProperties": false
        },
        "rationale": {
          "$ref": "../common.schema.json#/$defs/text_content"
        },
        "replace_existing": {
          "type": "boolean"
        },
        "replaces_installed_profile_id": {
          "$ref": "../common.schema.json#/$defs/record_id"
        },
        "replaces_installed_profile_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "expected_policy_state_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "proposal_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "status": {
          "const": "pending"
        },
        "created_at": {
          "$ref": "../common.schema.json#/$defs/timestamp"
        },
        "expires_at": {
          "$ref": "../common.schema.json#/$defs/timestamp"
        }
      },
      "required": [
        "schema_version",
        "proposal_id",
        "owner_agent_id",
        "owner_person",
        "source_task_id",
        "scope",
        "profile_name",
        "profile",
        "rationale",
        "replace_existing",
        "proposal_digest",
        "status",
        "created_at",
        "expires_at"
      ],
      "additionalProperties": false
    }
  }
}
