{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://universal-agents.local/contracts/messages/v1/schemas/bodies/blobs.delete_person.reply.schema.json",
  "title": "blobs.delete_person reply",
  "description": "How many blob ownership rows were removed, how many unowned blobs were deleted, and how many blobs were kept for other live owners.",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "outcome": {
          "const": "ok"
        },
        "owners_removed": {
          "$ref": "../common.schema.json#/$defs/count"
        },
        "blobs_deleted": {
          "$ref": "../common.schema.json#/$defs/count"
        },
        "blobs_kept": {
          "$ref": "../common.schema.json#/$defs/count"
        }
      },
      "required": [
        "outcome",
        "owners_removed",
        "blobs_deleted",
        "blobs_kept"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "outcome": {
          "const": "not_allowed"
        },
        "message": {
          "$ref": "../common.schema.json#/$defs/short_text"
        }
      },
      "required": [
        "outcome"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "outcome": {
          "const": "runtime_error"
        },
        "message": {
          "$ref": "../common.schema.json#/$defs/short_text"
        }
      },
      "required": [
        "outcome"
      ],
      "additionalProperties": false
    }
  ]
}
