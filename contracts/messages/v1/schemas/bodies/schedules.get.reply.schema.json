{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://universal-agents.local/contracts/messages/v1/schemas/bodies/schedules.get.reply.schema.json",
  "title": "schedules.get reply",
  "description": "Read complete safe details of one visible schedule, in JSON text pages.",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "outcome": {
          "const": "ok"
        },
        "schedule_id": {
          "$ref": "../common.schema.json#/$defs/record_id"
        },
        "seen_version": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "action": {
          "description": "What each run does, with schedules.install's action types: task gives the instruction to a model turn; fixed_message sends the text as it is, without a model turn. Every page carries it, outside the detail text.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "task",
                "fixed_message"
              ]
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        },
        "detail": {
          "type": "object",
          "properties": {
            "text": {
              "type": "string",
              "minLength": 0,
              "maxLength": 4000
            },
            "offset": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "total_chars": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "next_offset": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "text",
            "offset",
            "total_chars",
            "sha256"
          ],
          "additionalProperties": false
        },
        "delivery_ref": {
          "$ref": "../common.schema.json#/$defs/delivery_ref"
        },
        "conversation_id": {
          "$ref": "../common.schema.json#/$defs/record_id"
        }
      },
      "required": [
        "outcome",
        "schedule_id",
        "seen_version",
        "action",
        "detail"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "outcome": {
          "const": "not_found"
        },
        "message": {
          "$ref": "../common.schema.json#/$defs/short_text"
        }
      },
      "required": [
        "outcome"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "outcome": {
          "const": "not_allowed"
        },
        "message": {
          "$ref": "../common.schema.json#/$defs/short_text"
        }
      },
      "required": [
        "outcome"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "outcome": {
          "const": "invalid_request"
        },
        "message": {
          "$ref": "../common.schema.json#/$defs/short_text"
        }
      },
      "required": [
        "outcome"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "outcome": {
          "const": "runtime_error"
        },
        "message": {
          "$ref": "../common.schema.json#/$defs/short_text"
        }
      },
      "required": [
        "outcome"
      ],
      "additionalProperties": false
    }
  ]
}
