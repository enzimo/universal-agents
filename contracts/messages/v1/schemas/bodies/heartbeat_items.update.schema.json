{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://universal-agents.local/contracts/messages/v1/schemas/bodies/heartbeat_items.update.schema.json",
  "title": "heartbeat_items.update request",
  "description": "The lead changes a heartbeat item.",
  "type": "object",
  "properties": {
    "request_id": {
      "$ref": "../common.schema.json#/$defs/record_id"
    },
    "heartbeat_item_id": {
      "$ref": "../common.schema.json#/$defs/record_id"
    },
    "seen_version": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "instruction": {
      "$ref": "../common.schema.json#/$defs/text_content"
    },
    "title": {
      "type": "string",
      "minLength": 0,
      "maxLength": 16384
    },
    "target_agent_type": {
      "$ref": "../common.schema.json#/$defs/agent_type"
    },
    "objective_id": {
      "$ref": "../common.schema.json#/$defs/record_id"
    }
  },
  "required": [
    "request_id",
    "heartbeat_item_id",
    "seen_version"
  ],
  "additionalProperties": false
}
