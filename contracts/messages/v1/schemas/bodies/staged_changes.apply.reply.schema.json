    {
      "type": "object",
      "properties": {
        "outcome": {
          "const": "ok"
        },
        "state": {
          "const": "applied"
        },
        "approval": {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "person_approval",
                "held_access",
                "agreement",
                "operator_configuration"
              ]
            },
            "approved_by": {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            },
            "approved_at": {
              "$ref": "../common.schema.json#/$defs/timestamp"
            },
            "access_request_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            }
          },
          "required": [
            "mode",
            "approved_by",
            "approved_at"
          ],
          "additionalProperties": false,
          "description": "The recorded authority for the application. Only person_approval may carry access_request_id."
        },
        "note": {
          "type": "string",
          "maxLength": 2000
        },
        "result_json": {
          "type": "string",
          "minLength": 2,
          "maxLength": 16384,
          "description": "JSON text encoding the adapter's result object, including its receipt and error when supplied."
        }
      },
      "required": [
        "outcome",
        "state",
        "approval",
        "result_json"
      ],
      "additionalProperties": false
    },
    {
