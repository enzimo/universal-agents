{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://universal-agents.local/contracts/messages/v1/schemas/bodies/staged_changes.apply.reply.schema.json",
  "title": "staged_changes.apply reply",
  "description": "The lead applies a staged change the person reviewed.",
