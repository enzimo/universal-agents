{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://universal-agents.local/contracts/messages/v1/schemas/bodies/requests.pause.reply.schema.json",
  "title": "requests.pause reply",
  "description": "The lead pauses its own request's work.",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "outcome": {
          "const": "ok"
        },
        "state": {
          "type": "string",
          "enum": [
            "paused",
            "already_paused"
          ]
        },
        "held": {
          "$ref": "../common.schema.json#/$defs/count"
        }
      },
      "required": [
        "outcome",
        "state",
        "held"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "outcome": {
          "const": "not_found"
        },
        "message": {
          "$ref": "../common.schema.json#/$defs/short_text"
        }
      },
      "required": [
        "outcome"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "outcome": {
          "const": "request_closed"
        },
        "message": {
          "$ref": "../common.schema.json#/$defs/short_text"
        }
      },
      "required": [
        "outcome"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "outcome": {
          "const": "not_own_request"
        },
        "message": {
          "$ref": "../common.schema.json#/$defs/short_text"
        }
      },
      "required": [
        "outcome"
      ],
      "additionalProperties": false
    }
  ]
}
