{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://universal-agents.local/contracts/messages/v1/schemas/bodies/topics.list_tags.reply.schema.json",
  "title": "topics.list_tags reply",
  "description": "The thread tags in use.",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "outcome": {
          "const": "ok"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "tag": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
              },
              "thread_count": {
                "$ref": "../common.schema.json#/$defs/count"
              },
              "updated_at": {
                "$ref": "../common.schema.json#/$defs/timestamp"
              }
            },
            "required": [
              "tag",
              "thread_count",
              "updated_at"
            ],
            "additionalProperties": false
          },
          "maxItems": 200
        }
      },
      "required": [
        "outcome",
        "tags"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "outcome": {
          "const": "runtime_error"
        },
        "message": {
          "$ref": "../common.schema.json#/$defs/short_text"
        }
      },
      "required": [
        "outcome"
      ],
      "additionalProperties": false
    }
  ]
}
