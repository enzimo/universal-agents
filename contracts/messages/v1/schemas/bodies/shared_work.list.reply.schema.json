{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://universal-agents.local/contracts/messages/v1/schemas/bodies/shared_work.list.reply.schema.json",
  "title": "shared_work.list reply",
  "description": "The asking request's own claims and waits, and the person's other running requests, a page at a time.",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "outcome": {
          "const": "ok"
        },
        "this_request": {
          "description": "The asking request's own live claims and waits, whichever of its tasks took them.",
          "type": "object",
          "properties": {
            "claims": {
              "type": "array",
              "items": {
                "$ref": "../common.schema.json#/$defs/coordination_claim"
              },
              "maxItems": 8
            },
            "claims_total": {
              "$ref": "../common.schema.json#/$defs/count"
            },
            "waits": {
              "type": "array",
              "items": {
                "$ref": "../common.schema.json#/$defs/coordination_own_wait"
              },
              "maxItems": 8
            },
            "waits_total": {
              "$ref": "../common.schema.json#/$defs/count"
            }
          },
          "required": [
            "claims",
            "claims_total",
            "waits",
            "waits_total"
          ],
          "additionalProperties": false
        },
        "requests": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "root_task_id": {
                "$ref": "../common.schema.json#/$defs/record_id"
              },
              "title": {
                "$ref": "../common.schema.json#/$defs/coordination_request_title"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "chat",
                  "parallel_thread",
                  "scheduled_run",
                  "objective_work"
                ]
              },
              "state": {
                "type": "string",
                "enum": [
                  "running",
                  "queued",
                  "waiting_for_person",
                  "waiting_for_workers",
                  "waiting_for_request"
                ]
              },
              "last_activity": {
                "$ref": "../common.schema.json#/$defs/short_text"
              },
              "last_activity_at": {
                "$ref": "../common.schema.json#/$defs/timestamp"
              },
              "claims": {
                "type": "array",
                "items": {
                  "$ref": "../common.schema.json#/$defs/coordination_claim"
                },
                "maxItems": 8
              },
              "notes": {
                "type": "array",
                "items": {
                  "$ref": "../common.schema.json#/$defs/coordination_note"
                },
                "maxItems": 8
              },
              "claims_total": {
                "description": "How many of its live claims there are in all; the list holds the newest of them.",
                "$ref": "../common.schema.json#/$defs/count"
              },
              "notes_total": {
                "description": "How many notes it left there are in all; the list holds the newest of them.",
                "$ref": "../common.schema.json#/$defs/count"
              }
            },
            "required": [
              "root_task_id",
              "title",
              "kind",
              "state",
              "last_activity_at",
              "claims",
              "claims_total",
              "notes",
              "notes_total"
            ],
            "additionalProperties": false
          },
          "maxItems": 64
        },
        "total": {
          "description": "How many other running requests the person has.",
          "$ref": "../common.schema.json#/$defs/count"
        },
        "next_offset": {
          "description": "Where the next page starts; present only when more requests remain.",
          "$ref": "../common.schema.json#/$defs/count"
        }
      },
      "required": [
        "outcome",
        "this_request",
        "requests",
        "total"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "outcome": {
          "const": "not_allowed"
        },
        "message": {
          "$ref": "../common.schema.json#/$defs/short_text"
        }
      },
      "required": [
        "outcome"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "outcome": {
          "const": "runtime_error"
        },
        "message": {
          "$ref": "../common.schema.json#/$defs/short_text"
        }
      },
      "required": [
        "outcome"
      ],
      "additionalProperties": false
    }
  ]
}
