{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://universal-agents.local/contracts/messages/v1/schemas/bodies/knowledge.freeze.schema.json",
  "title": "knowledge.freeze request",
  "description": "A curator freezes a page.",
  "type": "object",
  "properties": {
    "request_id": {
      "$ref": "../common.schema.json#/$defs/record_id"
    },
    "space": {
      "type": "string",
      "enum": [
        "team",
        "personal"
      ]
    },
    "page": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "minutes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10080
    }
  },
  "required": [
    "request_id",
    "space",
    "page",
    "minutes"
  ],
  "additionalProperties": false
}
