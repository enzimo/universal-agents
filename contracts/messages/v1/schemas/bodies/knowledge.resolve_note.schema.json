{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://universal-agents.local/contracts/messages/v1/schemas/bodies/knowledge.resolve_note.schema.json",
  "title": "knowledge.resolve_note request",
  "description": "A curator resolves a note on a page.",
  "type": "object",
  "properties": {
    "request_id": {
      "$ref": "../common.schema.json#/$defs/record_id"
    },
    "space": {
      "type": "string",
      "enum": [
        "team",
        "personal"
      ]
    },
    "page": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "note_id": {
      "$ref": "../common.schema.json#/$defs/record_id"
    },
    "merged": {
      "type": "boolean",
      "description": "True after incorporating the note; false to dismiss it."
    }
  },
  "required": [
    "request_id",
    "note_id",
    "merged"
  ],
  "additionalProperties": false
}
