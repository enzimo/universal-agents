{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://universal-agents.local/contracts/messages/v1/schemas/bodies/shared_work.wait.reply.schema.json",
  "title": "shared_work.wait reply",
  "description": "Pause this request until a claimed resource or another of the person's requests is free.",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "outcome": {
          "const": "ok"
        },
        "wait_id": {
          "$ref": "../common.schema.json#/$defs/record_id"
        },
        "ends_by": {
          "description": "When the wait ends at the latest.",
          "$ref": "../common.schema.json#/$defs/timestamp"
        },
        "holder_waiting_for_person": {
          "description": "Whether what it waits for is itself waiting for the person.",
          "type": "boolean"
        }
      },
      "required": [
        "outcome",
        "wait_id",
        "ends_by",
        "holder_waiting_for_person"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "outcome": {
          "const": "not_allowed"
        },
        "message": {
          "$ref": "../common.schema.json#/$defs/short_text"
        }
      },
      "required": [
        "outcome"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "outcome": {
          "const": "invalid_request"
        },
        "message": {
          "$ref": "../common.schema.json#/$defs/short_text"
        }
      },
      "required": [
        "outcome"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "outcome": {
          "const": "not_found"
        },
        "message": {
          "$ref": "../common.schema.json#/$defs/short_text"
        }
      },
      "required": [
        "outcome"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "outcome": {
          "const": "nothing_to_wait_for"
        },
        "message": {
          "$ref": "../common.schema.json#/$defs/short_text"
        }
      },
      "required": [
        "outcome"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "outcome": {
          "const": "would_loop"
        },
        "reason": {
          "type": "string",
          "enum": [
            "own_request",
            "loop"
          ]
        },
        "holding": {
          "description": "What this request holds that the other one waits for.",
          "type": "array",
          "items": {
            "$ref": "../common.schema.json#/$defs/resource_key"
          },
          "maxItems": 8
        },
        "message": {
          "$ref": "../common.schema.json#/$defs/short_text"
        }
      },
      "required": [
        "outcome",
        "reason",
        "holding"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "outcome": {
          "const": "request_closed"
        },
        "message": {
          "$ref": "../common.schema.json#/$defs/short_text"
        }
      },
      "required": [
        "outcome"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "outcome": {
          "const": "runtime_error"
        },
        "message": {
          "$ref": "../common.schema.json#/$defs/short_text"
        }
      },
      "required": [
        "outcome"
      ],
      "additionalProperties": false
    }
  ]
}
