{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://universal-agents.local/contracts/messages/v1/schemas/bodies/shared_work.wait.reply.schema.json",
  "title": "shared_work.wait reply",
  "description": "Pause this request until a claimed resource or another of the person's requests is free.",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "outcome": {
          "const": "ok"
        },
        "wait_id": {
          "$ref": "../common.schema.json#/$defs/record_id"
        },
        "ends_by": {
          "description": "When the wait ends at the latest.",
          "$ref": "../common.schema.json#/$defs/timestamp"
        },
        "holder_waiting_for_person": {
          "description": "Present only when what it waits for is the asking person's own request or claim: whether that request is itself waiting for the person. Another person's request state is never shown.",
          "type": "boolean"
        }
      },
      "required": [
        "outcome",
        "wait_id",
        "ends_by"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "outcome": {
          "const": "not_allowed"
        },
        "message": {
          "$ref": "../common.schema.json#/$defs/short_text"
        }
      },
      "required": [
        "outcome"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "outcome": {
          "const": "invalid_request"
        },
        "message": {
          "$ref": "../common.schema.json#/$defs/short_text"
        }
      },
      "required": [
        "outcome"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "outcome": {
          "const": "sensitive_content"
        },
        "message": {
          "$ref": "../common.schema.json#/$defs/short_text"
        }
      },
      "required": [
        "outcome"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "outcome": {
          "const": "not_found"
        },
        "message": {
          "$ref": "../common.schema.json#/$defs/short_text"
        }
      },
      "required": [
        "outcome"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "outcome": {
          "const": "holds_claim"
        },
        "claims": {
          "description": "This request's own live claims on, above or under the resource, newest first: the request uses, extends or releases them instead of waiting.",
          "type": "array",
          "items": {
            "$ref": "../common.schema.json#/$defs/coordination_own_seen_claim"
          },
          "minItems": 1,
          "maxItems": 8
        },
        "claims_total": {
          "description": "How many such claims there are in all; the list holds the newest of them.",
          "$ref": "../common.schema.json#/$defs/count"
        },
        "message": {
          "$ref": "../common.schema.json#/$defs/short_text"
        }
      },
      "required": [
        "outcome",
        "claims",
        "claims_total"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "outcome": {
          "const": "nothing_to_wait_for"
        },
        "message": {
          "$ref": "../common.schema.json#/$defs/short_text"
        }
      },
      "required": [
        "outcome"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "outcome": {
          "const": "would_loop"
        },
        "reason": {
          "type": "string",
          "enum": [
            "own_request",
            "loop"
          ]
        },
        "holding": {
          "description": "What this request holds that the other request waits for, newest first.",
          "type": "array",
          "items": {
            "$ref": "../common.schema.json#/$defs/resource_key"
          },
          "maxItems": 8
        },
        "message": {
          "$ref": "../common.schema.json#/$defs/short_text"
        },
        "holding_total": {
          "description": "How many such resources there are in all.",
          "$ref": "../common.schema.json#/$defs/count"
        }
      },
      "required": [
        "outcome",
        "reason",
        "holding",
        "holding_total"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "outcome": {
          "const": "request_closed"
        },
        "message": {
          "$ref": "../common.schema.json#/$defs/short_text"
        }
      },
      "required": [
        "outcome"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "outcome": {
          "const": "runtime_error"
        },
        "message": {
          "$ref": "../common.schema.json#/$defs/short_text"
        }
      },
      "required": [
        "outcome"
      ],
      "additionalProperties": false
    }
  ]
}
