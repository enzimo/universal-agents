{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://universal-agents.local/contracts/messages/v1/schemas/bodies/knowledge.list.schema.json",
  "title": "knowledge.list request",
  "description": "List knowledge pages.",
  "type": "object",
  "properties": {
    "space": {
      "type": "string",
      "enum": [
        "team",
        "personal"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "archived"
      ]
    },
    "query": {
      "type": "string",
      "minLength": 1,
      "maxLength": 400
    },
    "offset": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100000
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20
    }
  },
  "required": [
    "space",
    "status",
    "offset",
    "limit"
  ],
  "additionalProperties": false
}
