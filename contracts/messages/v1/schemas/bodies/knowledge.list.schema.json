{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://universal-agents.local/contracts/messages/v1/schemas/bodies/knowledge.list.schema.json",
  "title": "knowledge.list request",
  "description": "List knowledge pages.",
  "type": "object",
  "properties": {
    "request_id": {
      "$ref": "../common.schema.json#/$defs/record_id"
    },
    "space": {
      "type": "string",
      "enum": [
        "all",
        "team",
        "personal"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "archived"
      ]
    },
    "query": {
      "type": "string",
      "minLength": 1,
      "maxLength": 400
    },
    "offset": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100000
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 50
    },
    "page_type": {
      "type": "string",
      "enum": [
        "concept",
        "how-to",
        "decision",
        "lesson",
        "reference",
        "source"
      ]
    },
    "tag": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    }
  },
  "required": [
    "request_id",
    "space",
    "status",
    "offset",
    "limit"
  ],
  "additionalProperties": false
}
