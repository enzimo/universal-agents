{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://universal-agents.local/contracts/messages/v1/schemas/bodies/intent.set.schema.json",
  "title": "intent.set request",
  "description": "The lead states a request's current intent.",
  "type": "object",
  "properties": {
    "request_id": {
      "$ref": "../common.schema.json#/$defs/record_id"
    },
    "root_task_id": {
      "$ref": "../common.schema.json#/$defs/record_id"
    },
    "seen_version": {
      "$ref": "../common.schema.json#/$defs/count"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    }
  },
  "required": [
    "request_id",
    "root_task_id",
    "seen_version",
    "text"
  ],
  "additionalProperties": false
}
