{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://universal-agents.local/contracts/messages/v1/schemas/bodies/credential.form.result.schema.json",
  "title": "credential.form.result body",
  "description": "What became of a credential form.",
  "type": "object",
  "properties": {
    "form_id": {
      "$ref": "../common.schema.json#/$defs/record_id"
    },
    "task_id": {
      "$ref": "../common.schema.json#/$defs/record_id"
    },
    "status": {
      "type": "string",
      "enum": [
        "signup_completed",
        "manual_signup_required",
        "manual_signup_collected",
        "signup_failed",
        "credential_stored",
        "credential_deleted",
        "credential_unavailable"
      ]
    },
    "continue_task": {
      "type": "boolean"
    },
    "credential_key": {
      "$ref": "../common.schema.json#/$defs/credential_key"
    },
    "service_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "display_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "broker_session_id": {
      "$ref": "../common.schema.json#/$defs/record_id"
    },
    "flow": {
      "type": "string",
      "enum": [
        "collect",
        "manual_signup",
        "delete"
      ]
    },
    "message": {
      "$ref": "../common.schema.json#/$defs/note_text"
    },
    "error": {
      "$ref": "../common.schema.json#/$defs/note_text"
    },
    "credential": {
      "type": "object",
      "properties": {
        "fields": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "kind": {
                "type": "string",
                "enum": [
                  "username",
                  "email",
                  "password",
                  "token",
                  "api_key",
                  "custom"
                ]
              },
              "visibility": {
                "type": "string",
                "enum": [
                  "metadata_visible",
                  "secret"
                ]
              },
              "value_source": {
                "type": "string",
                "enum": [
                  "user_input",
                  "agent_supplied_metadata",
                  "user_or_agent_supplied_metadata",
                  "store_generated_secret"
                ]
              },
              "secret": {
                "type": "boolean"
              },
              "value": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              }
            },
            "required": [
              "name",
              "kind",
              "visibility",
              "value_source",
              "secret"
            ],
            "additionalProperties": false
          },
          "maxItems": 20
        },
        "purpose": {
          "$ref": "../common.schema.json#/$defs/note_text"
        }
      },
      "required": [
        "fields"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "form_id",
    "task_id",
    "status",
    "continue_task",
    "credential_key",
    "service_name",
    "flow"
  ],
  "additionalProperties": false
}
