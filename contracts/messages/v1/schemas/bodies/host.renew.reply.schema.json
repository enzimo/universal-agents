{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://universal-agents.local/contracts/messages/v1/schemas/bodies/host.renew.reply.schema.json",
  "title": "host.renew.reply body",
  "description": "The installation authority's answer to a renewal: the renewed certificate and connection credential, or why it was refused.",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "outcome": {
          "const": "ok"
        },
        "certificate": {
          "$ref": "../certificate-document.schema.json"
        },
        "connection": {
          "description": "The host's NATS connection credential; absent when the installation issues none and its hosts share one NATS login.",
          "$ref": "../common.schema.json#/$defs/connection_credential"
        }
      },
      "required": [
        "outcome",
        "certificate"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "outcome": {
          "const": "revoked"
        },
        "revocation_epoch": {
          "$ref": "../common.schema.json#/$defs/epoch"
        },
        "message": {
          "$ref": "../common.schema.json#/$defs/short_text"
        }
      },
      "required": [
        "outcome",
        "revocation_epoch"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "outcome": {
          "const": "needs_approval"
        },
        "join_id": {
          "$ref": "../common.schema.json#/$defs/record_id"
        },
        "message": {
          "$ref": "../common.schema.json#/$defs/short_text"
        }
      },
      "required": [
        "outcome",
        "join_id"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "outcome": {
          "const": "protocol_mismatch"
        },
        "accepted": {
          "$ref": "../common.schema.json#/$defs/protocol_label"
        },
        "accepted_contract_sha256": {
          "description": "The contract digest the installation authority runs, so a host that runs the same label can see that its contract differs (README, \"Versions\").",
          "$ref": "../common.schema.json#/$defs/contract_sha256"
        },
        "install": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "message": {
          "$ref": "../common.schema.json#/$defs/short_text"
        }
      },
      "required": [
        "outcome",
        "accepted",
        "accepted_contract_sha256",
        "install"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "outcome": {
          "const": "not_allowed"
        },
        "message": {
          "$ref": "../common.schema.json#/$defs/short_text"
        }
      },
      "required": [
        "outcome"
      ],
      "additionalProperties": false
    }
  ]
}
