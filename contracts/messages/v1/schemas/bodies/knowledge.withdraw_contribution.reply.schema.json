{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://universal-agents.local/contracts/messages/v1/schemas/bodies/knowledge.withdraw_contribution.reply.schema.json",
  "title": "knowledge.withdraw_contribution reply",
  "description": "Withdraw one's own contribution.",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "outcome": {
          "const": "ok"
        },
        "contribution": {
          "type": "object",
          "properties": {
            "contribution_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            },
            "page": {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            },
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            },
            "state": {
              "type": "string",
              "enum": [
                "pending",
                "published",
                "withdrawn",
                "rejected"
              ]
            },
            "seen_version": {
              "$ref": "../common.schema.json#/$defs/record_version"
            },
            "created_at": {
              "$ref": "../common.schema.json#/$defs/timestamp"
            },
            "author": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "const": "agent"
                    },
                    "agent_type": {
                      "$ref": "../common.schema.json#/$defs/agent_type"
                    }
                  },
                  "required": [
                    "kind",
                    "agent_type"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "const": "person"
                    },
                    "person": {
                      "$ref": "../common.schema.json#/$defs/person_ref"
                    }
                  },
                  "required": [
                    "kind",
                    "person"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "const": "system"
                    }
                  },
                  "required": [
                    "kind"
                  ],
                  "additionalProperties": false
                }
              ]
            }
          },
          "required": [
            "contribution_id",
            "title",
            "state",
            "seen_version",
            "created_at",
            "author"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "outcome",
        "contribution"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "outcome": {
          "const": "not_found"
        },
        "message": {
          "$ref": "../common.schema.json#/$defs/short_text"
        }
      },
      "required": [
        "outcome"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "outcome": {
          "const": "not_allowed"
        },
        "message": {
          "$ref": "../common.schema.json#/$defs/short_text"
        }
      },
      "required": [
        "outcome"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "outcome": {
          "const": "contribution_not_pending"
        },
        "message": {
          "$ref": "../common.schema.json#/$defs/short_text"
        }
      },
      "required": [
        "outcome"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "outcome": {
          "const": "runtime_error"
        },
        "message": {
          "$ref": "../common.schema.json#/$defs/short_text"
        }
      },
      "required": [
        "outcome"
      ],
      "additionalProperties": false
    }
  ]
}
