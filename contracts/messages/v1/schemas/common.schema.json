{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://universal-agents.local/contracts/messages/v1/schemas/common.schema.json",
  "title": "Shared values of protocol 1",
  "$defs": {
    "token_id": {
      "description": "An id that is one NATS subject token. Ids starting with an underscore are reserved for the system; ids starting with x- name other installations.",
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
    },
    "team_id": {
      "$ref": "#/$defs/token_id"
    },
    "runtime_id": {
      "description": "One runtime host: a supervisor process that runs agent sessions. Unique within an installation.",
      "$ref": "#/$defs/token_id"
    },
    "agent_id": {
      "description": "An agent's stable id. It stays the same when the agent restarts or moves to another host.",
      "$ref": "#/$defs/token_id"
    },
    "agent_type": {
      "$ref": "#/$defs/token_id"
    },
    "record_id": {
      "description": "An id that names a task, command, question or other record. It may hold colons and dots, so it is never used as a subject token.",
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@-]{0,127}$"
    },
    "message_id": {
      "description": "A UUIDv7 in lower-case text form.",
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "idempotency_key": {
      "description": "The sender's key for one logical send. The same key always means the same message.",
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,255}$"
    },
    "kind": {
      "description": "A message kind or operation name: lower-case words joined by dots.",
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$",
      "maxLength": 96
    },
    "timestamp": {
      "description": "A UTC time with exactly three fractional digits.",
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "epoch": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "key_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "sha256_digest": {
      "description": "A SHA-256 digest in unpadded base64url.",
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "ed25519_signature": {
      "description": "An Ed25519 signature in unpadded base64url.",
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{86}$"
    },
    "ed25519_public_key": {
      "description": "An Ed25519 public key in unpadded base64url.",
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "person_ref": {
      "description": "An opaque reference to a person. It never holds a channel address, name or account id.",
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
    },
    "delivery_ref": {
      "description": "An opaque reference to where a person is reached. Only the gateway can resolve it.",
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
    },
    "blob_ref": {
      "description": "A file or long text in the object store, named by its digest.",
      "type": "object",
      "properties": {
        "sha256": {
          "$ref": "#/$defs/sha256_digest"
        },
        "size": {
          "$ref": "#/$defs/count"
        },
        "media_type": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9!#$&^_.+-]{0,63}/[a-z0-9][a-z0-9!#$&^_.+-]{0,63}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        }
      },
      "required": [
        "sha256",
        "size",
        "media_type"
      ],
      "additionalProperties": false
    },
    "issuer": {
      "description": "Who signed the frame: the host, and the agent session it signed for.",
      "type": "object",
      "properties": {
        "team": {
          "$ref": "#/$defs/team_id"
        },
        "runtime": {
          "$ref": "#/$defs/runtime_id"
        },
        "agent": {
          "$ref": "#/$defs/agent_id"
        },
        "session": {
          "$ref": "#/$defs/token_id"
        },
        "membership_epoch": {
          "$ref": "#/$defs/epoch"
        },
        "revocation_epoch": {
          "$ref": "#/$defs/epoch"
        },
        "key_id": {
          "$ref": "#/$defs/key_id"
        }
      },
      "required": [
        "team",
        "runtime",
        "membership_epoch",
        "revocation_epoch",
        "key_id"
      ],
      "additionalProperties": false
    },
    "audience": {
      "description": "Who the frame is for. Agents are named by id, never by the host that runs them.",
      "type": "object",
      "properties": {
        "team": {
          "$ref": "#/$defs/team_id"
        },
        "target": {
          "type": "string",
          "enum": [
            "agent",
            "pool",
            "team_services",
            "edge",
            "installation_service"
          ]
        },
        "id": {
          "$ref": "#/$defs/token_id"
        },
        "runtime": {
          "$ref": "#/$defs/runtime_id"
        }
      },
      "required": [
        "team",
        "target",
        "id"
      ],
      "additionalProperties": false
    },
    "authority_token": {
      "description": "Proof that work acts for a person, issued by the gateway or the scheduler and bound to one root task or one command. It is copied unchanged down a delegation tree.",
      "type": "object",
      "properties": {
        "token_id": {
          "$ref": "#/$defs/message_id"
        },
        "issuer": {
          "type": "object",
          "properties": {
            "team": {
              "$ref": "#/$defs/team_id"
            },
            "runtime": {
              "$ref": "#/$defs/runtime_id"
            },
            "key_id": {
              "$ref": "#/$defs/key_id"
            }
          },
          "required": [
            "team",
            "runtime",
            "key_id"
          ],
          "additionalProperties": false
        },
        "person": {
          "$ref": "#/$defs/person_ref"
        },
        "team": {
          "$ref": "#/$defs/team_id"
        },
        "bound_to": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "root_task",
                "command"
              ]
            },
            "id": {
              "$ref": "#/$defs/record_id"
            }
          },
          "required": [
            "type",
            "id"
          ],
          "additionalProperties": false
        },
        "issued_at": {
          "$ref": "#/$defs/timestamp"
        },
        "expires_at": {
          "$ref": "#/$defs/timestamp"
        },
        "algorithm": {
          "const": "ed25519"
        },
        "signature": {
          "$ref": "#/$defs/ed25519_signature"
        }
      },
      "required": [
        "token_id",
        "issuer",
        "person",
        "team",
        "bound_to",
        "issued_at",
        "expires_at",
        "algorithm",
        "signature"
      ],
      "additionalProperties": false
    },
    "short_text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "note_text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "long_text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32768
    },
    "time_zone": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_+-]{0,31}(/[A-Za-z0-9_+-]{1,31}){0,2}$"
    },
    "tool_id": {
      "type": "string",
      "pattern": "^(fn|cli|http|mcp|procedure|code):[a-z0-9][a-z0-9_.-]{0,95}$"
    },
    "credential_key": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,119}$"
    },
    "change_record_kind": {
      "type": "string",
      "enum": [
        "memory_fact",
        "knowledge_page",
        "schedule",
        "objective",
        "heartbeat_item",
        "file",
        "staged_change"
      ]
    },
    "custody_token": {
      "description": "The custody record's revision. A holder learns it from its claim's confirmation.",
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "attachment": {
      "type": "object",
      "description": "A file sent with a message, held in the object store.",
      "properties": {
        "attachment_id": {
          "$ref": "#/$defs/record_id"
        },
        "blob": {
          "$ref": "#/$defs/blob_ref"
        },
        "kind": {
          "type": "string",
          "enum": [
            "image",
            "document",
            "audio",
            "video",
            "other"
          ]
        },
        "caption": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      },
      "required": [
        "attachment_id",
        "blob",
        "kind"
      ],
      "additionalProperties": false
    },
    "replied_message": {
      "type": "object",
      "description": "The message the person replied to.",
      "properties": {
        "author": {
          "type": "string",
          "enum": [
            "assistant",
            "requester",
            "other"
          ]
        },
        "author_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16000
        },
        "shortened": {
          "type": "boolean"
        },
        "quoted_text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16000
        },
        "sent_at": {
          "$ref": "#/$defs/timestamp"
        }
      },
      "required": [
        "author",
        "text",
        "shortened"
      ],
      "additionalProperties": false
    },
    "failure": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "category": {
              "const": "provider_limited"
            },
            "provider": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            "model_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            },
            "status_code": {
              "type": "integer",
              "minimum": 100,
              "maximum": 599
            },
            "attempts": {
              "$ref": "#/$defs/count"
            },
            "message": {
              "$ref": "#/$defs/note_text"
            }
          },
          "required": [
            "category",
            "provider",
            "model_id",
            "attempts"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "category": {
              "const": "worker_lost"
            },
            "attempts": {
              "$ref": "#/$defs/count"
            },
            "message": {
              "$ref": "#/$defs/note_text"
            }
          },
          "required": [
            "category",
            "attempts"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "category": {
              "const": "admission_refused"
            },
            "message": {
              "$ref": "#/$defs/note_text"
            }
          },
          "required": [
            "category"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "category": {
              "const": "budget_exhausted"
            },
            "message": {
              "$ref": "#/$defs/note_text"
            }
          },
          "required": [
            "category"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "category": {
              "const": "deadline_reached"
            },
            "message": {
              "$ref": "#/$defs/note_text"
            }
          },
          "required": [
            "category"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "category": {
              "const": "not_allowed"
            },
            "message": {
              "$ref": "#/$defs/note_text"
            }
          },
          "required": [
            "category"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "category": {
              "const": "error"
            },
            "message": {
              "$ref": "#/$defs/note_text"
            }
          },
          "required": [
            "category"
          ],
          "additionalProperties": false
        }
      ]
    },
    "question_choice": {
      "type": "object",
      "properties": {
        "choice_id": {
          "type": "string",
          "pattern": "^[a-z0-9_-]{1,64}$"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "recommended": {
          "type": "boolean"
        }
      },
      "required": [
        "choice_id",
        "label",
        "recommended"
      ],
      "additionalProperties": false
    },
    "assumption": {
      "type": "object",
      "description": "Something the work relied on that later steering may change.",
      "properties": {
        "assumption_id": {
          "$ref": "#/$defs/record_id"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "affects": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "maxItems": 20
        }
      },
      "required": [
        "assumption_id",
        "text"
      ],
      "additionalProperties": false
    },
    "held_action": {
      "type": "object",
      "description": "An outward action and how far it got.",
      "properties": {
        "action_id": {
          "$ref": "#/$defs/record_id"
        },
        "action_type": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,119}$"
        },
        "summary": {
          "$ref": "#/$defs/short_text"
        },
        "state": {
          "type": "string",
          "enum": [
            "held",
            "outcome_unknown",
            "sent",
            "completed"
          ]
        }
      },
      "required": [
        "action_id",
        "action_type",
        "summary",
        "state"
      ],
      "additionalProperties": false
    },
    "decision_ahead": {
      "type": "object",
      "description": "A decision the lead made in advance for one task or schedule.",
      "properties": {
        "decision_id": {
          "$ref": "#/$defs/record_id"
        },
        "kind": {
          "type": "string",
          "enum": [
            "forward_result_to_person",
            "forward_progress_to_person",
            "forward_steering_to_holders"
          ]
        }
      },
      "required": [
        "decision_id",
        "kind"
      ],
      "additionalProperties": false
    },
    "decision_token": {
      "type": "object",
      "description": "A person's decision on a change conflict, bound to a digest of the values they were shown.",
      "properties": {
        "token_id": {
          "$ref": "#/$defs/message_id"
        },
        "case_id": {
          "$ref": "#/$defs/record_id"
        },
        "choice": {
          "type": "string",
          "enum": [
            "keep_current",
            "use_this_change",
            "redo_with_note",
            "stop_request"
          ]
        },
        "values_digest": {
          "$ref": "#/$defs/sha256_digest"
        },
        "issuer": {
          "type": "object",
          "properties": {
            "team": {
              "$ref": "#/$defs/team_id"
            },
            "runtime": {
              "$ref": "#/$defs/runtime_id"
            },
            "key_id": {
              "$ref": "#/$defs/key_id"
            }
          },
          "required": [
            "team",
            "runtime",
            "key_id"
          ],
          "additionalProperties": false
        },
        "issued_at": {
          "$ref": "#/$defs/timestamp"
        },
        "expires_at": {
          "$ref": "#/$defs/timestamp"
        },
        "algorithm": {
          "const": "ed25519"
        },
        "signature": {
          "$ref": "#/$defs/ed25519_signature"
        }
      },
      "required": [
        "token_id",
        "case_id",
        "choice",
        "values_digest",
        "issuer",
        "issued_at",
        "expires_at",
        "algorithm",
        "signature"
      ],
      "additionalProperties": false
    },
    "access_target": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "tool",
            "tool_set",
            "folder"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "additionalProperties": false
    },
    "work_context": {
      "type": "object",
      "description": "Where a task sits in its request and how it should run.",
      "properties": {
        "origin": {
          "type": "string",
          "enum": [
            "person_request",
            "delegation",
            "schedule_run",
            "system_work",
            "other_team",
            "outside_agent"
          ]
        },
        "root_task_id": {
          "$ref": "#/$defs/record_id"
        },
        "parent_task_id": {
          "$ref": "#/$defs/record_id"
        },
        "conversation_id": {
          "$ref": "#/$defs/record_id"
        },
        "follows_task_id": {
          "$ref": "#/$defs/record_id"
        },
        "objective_id": {
          "$ref": "#/$defs/record_id"
        },
        "schedule_id": {
          "$ref": "#/$defs/record_id"
        },
        "time_zone": {
          "$ref": "#/$defs/time_zone"
        },
        "delivery_ref": {
          "$ref": "#/$defs/delivery_ref"
        },
        "started_on_purpose": {
          "type": "boolean"
        },
        "topology": {
          "type": "string",
          "enum": [
            "hub_and_spoke",
            "same_type_peers",
            "all_peers",
            "nested"
          ]
        },
        "intent": {
          "type": "object",
          "properties": {
            "version": {
              "$ref": "#/$defs/count"
            },
            "text": {
              "$ref": "#/$defs/note_text"
            }
          },
          "required": [
            "version",
            "text"
          ],
          "additionalProperties": false
        },
        "root_request": {
          "$ref": "#/$defs/blob_ref"
        },
        "deadline": {
          "type": "object",
          "properties": {
            "at": {
              "$ref": "#/$defs/timestamp"
            },
            "rule": {
              "type": "string",
              "enum": [
                "partial_result",
                "stop",
                "continue"
              ]
            }
          },
          "required": [
            "at",
            "rule"
          ],
          "additionalProperties": false
        },
        "expected_offline_until": {
          "$ref": "#/$defs/timestamp"
        },
        "decisions_ahead": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/decision_ahead"
          },
          "maxItems": 8
        }
      },
      "required": [
        "origin",
        "root_task_id",
        "topology"
      ],
      "additionalProperties": false
    },
    "ledger_snapshot": {
      "type": "object",
      "description": "A task's open work, carried by a handback so its new holder keeps the same labels.",
      "properties": {
        "plan": {
          "$ref": "#/$defs/blob_ref"
        },
        "checkpoint": {
          "$ref": "#/$defs/blob_ref"
        },
        "history_summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "delegations": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "task_id": {
                "$ref": "#/$defs/record_id"
              },
              "number": {
                "$ref": "#/$defs/count"
              },
              "holder": {
                "$ref": "#/$defs/agent_id"
              },
              "state": {
                "type": "string",
                "enum": [
                  "open",
                  "standin",
                  "resolved",
                  "late_work"
                ]
              }
            },
            "required": [
              "task_id",
              "number",
              "state"
            ],
            "additionalProperties": false
          },
          "maxItems": 200
        },
        "questions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "question_id": {
                "$ref": "#/$defs/record_id"
              },
              "number": {
                "$ref": "#/$defs/count"
              },
              "purpose": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,63}$"
              }
            },
            "required": [
              "question_id",
              "number",
              "purpose"
            ],
            "additionalProperties": false
          },
          "maxItems": 50
        },
        "assumptions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/assumption"
          },
          "maxItems": 50
        },
        "held_actions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/held_action"
          },
          "maxItems": 50
        },
        "counters": {
          "type": "object",
          "properties": {
            "subtask": {
              "$ref": "#/$defs/count"
            },
            "question": {
              "$ref": "#/$defs/count"
            },
            "attachment": {
              "$ref": "#/$defs/count"
            },
            "report": {
              "$ref": "#/$defs/count"
            }
          },
          "required": [
            "subtask",
            "question",
            "attachment",
            "report"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "delegations",
        "questions",
        "assumptions",
        "held_actions",
        "counters"
      ],
      "additionalProperties": false
    }
  }
}
