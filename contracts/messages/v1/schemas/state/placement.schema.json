{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://universal-agents.local/contracts/messages/v1/schemas/state/placement.schema.json",
  "title": "placement state record body",
  "description": "Which host runs an agent; its signed sequence is the fencing token.",
  "type": "object",
  "properties": {
    "team": {
      "$ref": "../common.schema.json#/$defs/team_id"
    },
    "agent": {
      "$ref": "../common.schema.json#/$defs/agent_id"
    },
    "agent_type": {
      "$ref": "../common.schema.json#/$defs/agent_type"
    },
    "host": {
      "$ref": "../common.schema.json#/$defs/runtime_id"
    },
    "host_epoch": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991,
      "description": "The membership epoch of the host's certificate when the agent was placed. Renewals do not move the agent: a reader accepts the placement while the host's liveness record names a certificate of that runtime at this epoch or later."
    },
    "definition_sha256": {
      "$ref": "../common.schema.json#/$defs/sha256_digest"
    },
    "required_labels": {
      "type": "array",
      "items": {
        "$ref": "../common.schema.json#/$defs/placement_label"
      },
      "maxItems": 32
    },
    "placed_at": {
      "$ref": "../common.schema.json#/$defs/timestamp"
    },
    "reason": {
      "type": "string",
      "enum": [
        "initial",
        "host_lost",
        "rebalanced",
        "drained",
        "operator"
      ]
    },
    "previous_host": {
      "$ref": "../common.schema.json#/$defs/runtime_id"
    },
    "handed_over": {
      "const": true,
      "description": "The team services kept this placement on an explicit handed_over close. It survives deletion of the ended session; unmarked placements without any retained matching session are abandoned."
    }
  },
  "required": [
    "team",
    "agent",
    "agent_type",
    "host",
    "host_epoch",
    "definition_sha256",
    "placed_at",
    "reason"
  ],
  "additionalProperties": false
}
