{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://universal-agents.local/contracts/messages/v1/schemas/state/revocations.schema.json",
  "title": "Revoked certificates",
  "description": "An installation's revoked host certificates. A listed certificate stops every frame and record that relies on it and was not already admitted, whenever that frame or record says it was issued.",
  "type": "object",
  "properties": {
    "installation": {
      "$ref": "../common.schema.json#/$defs/installation_id"
    },
    "revocation_epoch": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "entries": {
      "type": "array",
      "maxItems": 2000,
      "items": {
        "type": "object",
        "properties": {
          "certificate_id": {
            "$ref": "../common.schema.json#/$defs/record_id"
          },
          "runtime": {
            "$ref": "../common.schema.json#/$defs/runtime_id"
          },
          "membership_epoch": {
            "$ref": "../common.schema.json#/$defs/epoch"
          },
          "revoked_at": {
            "$ref": "../common.schema.json#/$defs/timestamp"
          },
          "reason": {
            "type": "string",
            "enum": [
              "compromised",
              "decommissioned",
              "quarantined"
            ]
          }
        },
        "required": [
          "certificate_id",
          "runtime",
          "membership_epoch",
          "revoked_at",
          "reason"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "installation",
    "revocation_epoch",
    "entries"
  ],
  "additionalProperties": false
}
