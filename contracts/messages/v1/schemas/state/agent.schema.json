{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://universal-agents.local/contracts/messages/v1/schemas/state/agent.schema.json",
  "title": "agent state record body",
  "description": "An agent's state, written by the host it is placed on when the state changes.",
  "type": "object",
  "properties": {
    "team": {
      "$ref": "../common.schema.json#/$defs/team_id"
    },
    "agent": {
      "$ref": "../common.schema.json#/$defs/agent_id"
    },
    "agent_type": {
      "$ref": "../common.schema.json#/$defs/agent_type"
    },
    "display_name": {
      "description": "The agent's name as the team knows it (the lead routes by it and the gateway's Team page shows it); not a person's name.",
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "session": {
      "$ref": "../common.schema.json#/$defs/token_id"
    },
    "state": {
      "type": "string",
      "enum": [
        "starting",
        "idle",
        "busy",
        "paused",
        "exiting",
        "stopped"
      ]
    },
    "accepting_work": {
      "type": "boolean"
    },
    "since": {
      "$ref": "../common.schema.json#/$defs/timestamp"
    }
  },
  "required": [
    "team",
    "agent",
    "agent_type",
    "session",
    "state",
    "accepting_work",
    "since"
  ],
  "additionalProperties": false
}
