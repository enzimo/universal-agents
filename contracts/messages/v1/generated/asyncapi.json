  "components": {
    "messages": {
      "access_decision": {
        "name": "access.decision",
        "payload": {
          "$ref": "../schemas/bodies/access.decision.schema.json"
        },
        "summary": "What became of an access request, sent to the waiting task."
      },
      "access_request": {
        "name": "access.request",
        "payload": {
          "$ref": "../schemas/bodies/access.request.schema.json"
        },
        "summary": "A task asks the team services for access; no model decides it."
      },
      "access_resolved": {
        "name": "access.resolved",
        "payload": {
          "$ref": "../schemas/bodies/access.resolved.schema.json"
        },
        "summary": "A person's decision on an access request, from the gateway to the team services."
      },
      "agent_pause": {
        "name": "agent.pause",
        "payload": {
          "$ref": "../schemas/bodies/agent.pause.schema.json"
        },
        "summary": "Pause one agent at its next safe point; it keeps its queued work."
      },
      "agent_pause_reply": {
        "name": "agent.pause.reply",
        "payload": {
          "$ref": "../schemas/bodies/agent.pause.reply.schema.json"
        }
      },
      "credential_form_request": {
        "name": "credential.form.request",
        "payload": {
          "$ref": "../schemas/bodies/credential.form.request.schema.json"
        },
        "summary": "Ask the gateway to collect, set up or delete a credential through a secure form."
      },
      "credential_form_result": {
        "name": "credential.form.result",
        "payload": {
          "$ref": "../schemas/bodies/credential.form.result.schema.json"
        },
        "summary": "What became of a credential form."
      },
      "custody_moved": {
        "name": "custody.moved",
        "payload": {
          "$ref": "../schemas/bodies/custody.moved.schema.json"
        },
        "summary": "Tells a former holder that its task moved; later results are kept as late work."
      },
      "delivery_receipt": {
        "name": "delivery.receipt",
        "payload": {
          "$ref": "../schemas/bodies/delivery.receipt.schema.json"
        },
        "summary": "The gateway delivered an answer or notice to a person."
      },
      "delivery_refused": {
        "name": "delivery.refused",
        "payload": {
          "$ref": "../schemas/bodies/delivery.refused.schema.json"
        },
        "summary": "A receiver refused a message; sent back to its sender."
      },
      "ledger_fact": {
        "name": "ledger.fact",
        "payload": {
          "$ref": "../schemas/bodies/ledger.fact.schema.json"
        },
        "summary": "A fact for an agent's work ledger from the team services."
      },
      "person_notify": {
        "name": "person.notify",
        "payload": {
          "$ref": "../schemas/bodies/person.notify.schema.json"
        },
        "summary": "A notice for a person, delivered by the gateway."
      },
      "question_closed": {
        "name": "question.closed",
        "payload": {
          "$ref": "../schemas/bodies/question.closed.schema.json"
        },
        "summary": "A question ended without an answer."
      },
      "skills_changed": {
        "name": "skills.changed",
        "payload": {
          "$ref": "../schemas/bodies/skills.changed.schema.json"
        },
        "summary": "Hint that a managed skill was installed or removed. Receivers verify the stored receipt before they refresh."
      },
      "task_account": {
        "name": "task.account",
        "payload": {
          "$ref": "../schemas/bodies/task.account.schema.json"
        },
        "summary": "A held holder's account of where its task stopped."
      },
      "task_answer": {
        "name": "task.answer",
        "payload": {
          "$ref": "../schemas/bodies/task.answer.schema.json"
        },
        "summary": "The answer to one question."
      },
      "task_claimed": {
        "name": "task.claimed",
        "payload": {
          "$ref": "../schemas/bodies/task.claimed.schema.json"
        },
        "summary": "A holder took a task."
      },
      "task_handback": {
        "name": "task.handback",
        "payload": {
          "$ref": "../schemas/bodies/task.handback.schema.json"
        },
        "summary": "A holder that lost its lease returns a task."
      },
      "task_progress": {
        "name": "task.progress",
        "payload": {
          "$ref": "../schemas/bodies/task.progress.schema.json"
        },
        "summary": "Where a task stands, from its holder to its requester."
      },
      "task_question": {
        "name": "task.question",
        "payload": {
          "$ref": "../schemas/bodies/task.question.schema.json"
        },
        "summary": "A question from a task's holder to the one who can answer it."
      },
      "task_report": {
        "name": "task.report",
        "payload": {
          "$ref": "../schemas/bodies/task.report.schema.json"
        },
        "summary": "A report from a holder to its requester; the lead decides whether a person sees it."
      },
      "task_request": {
        "name": "task.request",
        "payload": {
          "$ref": "../schemas/bodies/task.request.schema.json"
        },
        "summary": "Give a task to an agent or a pool."
      },
      "task_result": {
        "name": "task.result",
        "payload": {
          "$ref": "../schemas/bodies/task.result.schema.json"
        },
        "summary": "The final answer of a task, sent by its holder."
      },
      "task_steer": {
        "name": "task.steer",
        "payload": {
          "$ref": "../schemas/bodies/task.steer.schema.json"
        },
        "summary": "Steering for the holder of one named task."
      },
      "task_stop": {
        "name": "task.stop",
        "payload": {
          "$ref": "../schemas/bodies/task.stop.schema.json"
        },
        "summary": "Stop one task. Sent only to the task's current holder."
      },
      "tool_setup_request": {
        "name": "tool.setup.request",
        "payload": {
          "$ref": "../schemas/bodies/tool.setup.request.schema.json"
        },
        "summary": "Ask the gateway to have a person or administrator set a tool up."
      },
      "tool_setup_result": {
        "name": "tool.setup.result",
        "payload": {
          "$ref": "../schemas/bodies/tool.setup.result.schema.json"
        },
        "summary": "What became of a tool setup."
      }
    }
  },
  "defaultContentType": "application/json",
