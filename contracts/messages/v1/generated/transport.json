{
  "agent_queues": {
    "control": "work.control.{agent}",
    "inbox": "work.agent.{agent}"
  },
  "audience_targets": {
    "agent": [
      "lead_host",
      "worker_host"
    ],
    "edge": [
      "gateway",
      "edge_adapter"
    ],
    "host": [
      "gateway",
      "lead_host",
      "worker_host",
      "team_services",
      "edge_adapter",
      "installation_authority",
      "scheduler"
    ],
    "installation_service": [
      "installation_authority"
    ],
    "pool": [
      "lead_host",
      "worker_host"
    ],
    "team": [
      "gateway",
      "lead_host",
      "worker_host",
      "team_services",
      "edge_adapter",
      "installation_authority",
      "scheduler"
    ],
    "team_services": [
      "team_services",
      "scheduler"
    ]
  },
  "classes": {
    "dead_letter": {
      "addresses": [
        "dlq.raw.{copy}",
        "dlq.notice.{copy}"
      ],
      "between_installations": false,
      "description": "set-aside copies and notices, under the receiving runtime's id",
      "max_expiry_seconds": 2592000,
      "streams": [
        "UA1_DLQ_{team}"
      ]
    },
    "durable": {
      "addresses": [
        "work.agent.{agent}",
        "work.control.{agent}",
        "work.pool.{pool}",
        "work.edge.{edge}",
        "work.team"
      ],
      "between_installations": true,
      "description": "at least once; the sender records before publishing, the receiver admits durably before acknowledging",
      "max_expiry_seconds": 604800,
      "streams": [
        "UA1_AGENT_WORK_{team}",
        "UA1_WORK"
      ]
    },
    "event": {
      "addresses": [
        "evt.{event}"
      ],
      "between_installations": false,
      "description": "at most once; never the only way something important happens",
      "max_expiry_seconds": 300
    },
    "request_reply": {
      "addresses": [
        "svc.team",
        "svc.scheduler",
        "ctl.agent.{agent}"
      ],
      "between_installations": false,
      "description": "answered at once or \"no responders\"; changes carry an idempotency key, and the receiver stores the final outcome with the change before replying, except outcomes that ask for a retry (README, \"Stored outcomes\")",
      "installation_addresses": [
        "_install.{sender}.svc"
      ],
      "max_expiry_seconds": 30
    }
  },
  "clock_skew_seconds": 8,
  "consumers": {
    "agent_control": {
      "ack": "explicit",
      "ack_wait_seconds": 60,
      "filter": "ua.v1.{team}.*.work.control.{agent}",
      "max_deliveries": 20,
      "mode": "pull",
      "name": "control~{team}~{agent}",
      "stream": "UA1_AGENT_WORK_{team}"
    },
    "agent_inbox": {
      "ack": "explicit",
      "ack_wait_seconds": 60,
      "filter": "ua.v1.{team}.*.work.agent.{agent}",
      "max_deliveries": 20,
      "mode": "pull",
      "name": "agent~{team}~{agent}",
      "stream": "UA1_AGENT_WORK_{team}"
    },
    "dead_letters": {
      "ack": "explicit",
      "ack_wait_seconds": 60,
      "filter": "ua.v1.{team}.*.dlq.notice.*",
      "max_deliveries": 20,
      "mode": "pull",
      "name": "dlq~{team}",
      "stream": "UA1_DLQ_{team}"
    },
    "edge": {
      "ack": "explicit",
      "ack_wait_seconds": 60,
      "filter": "ua.v1.{team}.*.work.edge.{edge}",
      "max_deliveries": 20,
      "mode": "pull",
      "name": "edge~{team}~{edge}",
      "stream": "UA1_WORK"
    },
    "pool": {
      "ack": "explicit",
      "ack_wait_seconds": 60,
      "filter": "ua.v1.{team}.*.work.pool.{pool}",
      "max_deliveries": 20,
      "mode": "pull",
      "name": "pool~{team}~{pool}",
      "stream": "UA1_AGENT_WORK_{team}"
    },
    "team_services": {
      "ack": "explicit",
      "ack_wait_seconds": 60,
      "filter": "ua.v1.{team}.*.work.team",
      "max_deliveries": 20,
      "mode": "pull",
      "name": "team~{team}",
      "stream": "UA1_WORK"
    }
  },
  "dead_letter_custody": {
    "role": "team_services",
    "streams": [
      "UA1_DLQ_{team}"
    ]
  },
  "installation_scope": "_install",
  "key_value": {
    "UA1_AGENTS": {
      "description": "one record per agent, written on change and refreshed every minute; abandoned records expire within three minutes",
      "per_key_ttl_seconds": 180,
      "readers": [
        "gateway",
        "lead_host",
        "worker_host",
        "team_services",
        "edge_adapter",
        "installation_authority",
        "scheduler"
      ],
      "writers": {
        "lead_host": [
          "{team}.{agent}"
        ],
        "worker_host": [
          "{team}.{agent}"
        ]
      }
    },
    "UA1_BLOCK_LIST_{team}": {
      "description": "one team's block list, written by its team services and read by its hosts; one bucket per team, since it names people's blocks and standing; each record states its own expiry",
      "per_key_ttl_seconds": 0,
      "readers": [
        "lead_host",
        "worker_host",
        "team_services"
      ],
      "writers": {
        "team_services": [
          "{team}"
        ]
      }
    },
    "UA1_CERTS": {
      "description": "host certificates, revocations, agent sessions and agreements (registry state_records); each record is signed, so readers trust the signature, not the bucket",
      "per_key_ttl_seconds": 0,
      "readers": [
        "gateway",
        "lead_host",
        "worker_host",
        "team_services",
        "edge_adapter",
        "installation_authority",
        "scheduler"
      ],
      "writers": {
        "edge_adapter": [
          "host.{peer}.>",
          "revocations.{peer}",
          "session.{peer}.>"
        ],
        "installation_authority": [
          "host.{installation}.>",
          "revocations.{installation}",
          "agreement.*"
        ],
        "team_services": [
          "session.{installation}.{team}.*"
        ]
      }
    },
    "UA1_HOSTS": {
      "description": "one record per runtime host; written every 10 s, expires after at most 30 s (each record also states its expiry)",
      "per_key_ttl_seconds": 30,
      "readers": [
        "gateway",
        "lead_host",
        "worker_host",
        "team_services",
        "edge_adapter",
        "installation_authority",
        "scheduler"
      ],
      "writers": {
        "edge_adapter": [
          "{self}"
        ],
        "gateway": [
          "{self}"
        ],
        "installation_authority": [
          "{self}"
        ],
        "lead_host": [
          "{self}"
        ],
        "scheduler": [
          "{self}"
        ],
        "team_services": [
          "{self}"
        ],
        "worker_host": [
          "{self}"
        ]
      }
    },
    "UA1_LOCKS": {
      "description": "the team services' single-instance lock, one key per team (team_services.<team>), its value schemas/team-services-lock.schema.json: the holder's runtime id, its process instance and its lease's end, a 30-second lease taken and renewed every 10 seconds with compare-and-set; another instance does not serve while the lease holds",
      "per_key_ttl_seconds": 0,
      "readers": [
        "team_services"
      ],
      "writers": {
        "team_services": [
          "team_services.{team}"
        ]
      }
    },
    "UA1_PLACEMENT": {
      "description": "which host runs an agent and that host's epoch; the record's signed sequence is the fencing token",
      "per_key_ttl_seconds": 0,
      "readers": [
        "gateway",
        "lead_host",
        "worker_host",
        "team_services",
        "edge_adapter",
        "installation_authority",
        "scheduler"
      ],
      "writers": {
        "team_services": [
          "{team}.*"
        ]
      }
    },
    "UA1_TEAM_VIEW_{team}": {
      "description": "one team's shared view of open work; one bucket per team, since an Objective's title is a person's own words",
      "per_key_ttl_seconds": 0,
      "readers": [
        "gateway",
        "lead_host",
        "worker_host",
        "team_services"
      ],
      "writers": {
        "team_services": [
          "{team}.>"
        ]
      }
    }
  },
  "key_value_stream": {
    "allow_direct": true,
    "allow_rollup_hdrs": false,
    "deny_delete": true,
    "deny_purge": true,
    "history": 1,
    "max_consumers": 4096,
    "storage": "file"
  },
  "limits": {
    "max_credential_bytes": 65536,
    "max_frame_bytes": 262144,
    "max_header_bytes": 1024,
    "nats_max_payload_bytes": 1048576
  },
  "object_store": {
    "UA1_BLOBS": {
      "description": "files and long text, named by SHA-256; the owner deletes them"
    }
  },
  "peer_sender_slot": "x-{installation}",
  "replay_ledger_retention_seconds": 2592060,
  "reply_inbox_prefix": "_INBOX.{runtime}",
  "server": {
    "jetstream": {
      "sync_interval": "always"
    },
    "minimum_version": "2.15.1"
  },
  "streams": {
    "UA1_AGENT_WORK_{team}": {
      "duplicate_window_seconds": 120,
      "max_age_seconds": 604860,
      "max_consumers": 4096,
      "max_message_bytes": 263168,
      "retention": "workqueue",
      "storage": "file",
      "subjects": [
        "ua.v1.{team}.*.work.agent.*",
        "ua.v1.{team}.*.work.control.*",
        "ua.v1.{team}.*.work.pool.*"
      ]
    },
    "UA1_DLQ_{team}": {
      "max_age_seconds": 2592060,
      "max_consumers": 16,
      "max_message_bytes": 263168,
      "max_msgs_per_subject": 1,
      "retention": "limits",
      "storage": "file",
      "subjects": [
        "ua.v1.{team}.*.dlq.>"
      ]
    },
    "UA1_WORK": {
      "duplicate_window_seconds": 120,
      "max_age_seconds": 604860,
      "max_consumers": 4096,
      "max_message_bytes": 263168,
      "retention": "workqueue",
      "storage": "file",
      "subjects": [
        "ua.v1.*.*.work.edge.*",
        "ua.v1.*.*.work.team"
      ]
    }
  },
  "subject_prefix": "ua.v1.{team}.{sender}",
  "topology_owner": "installation_authority",
  "withdrawal": {
    "role": "team_services",
    "streams": [
      "UA1_AGENT_WORK_{team}"
    ]
  }
}
