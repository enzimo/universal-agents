{
  "authority_token_domain": "universal-agents/authority-token/v1",
  "authority_token_max_seconds": 604800,
  "change_refusals": [
    {
      "code": "changed_since_read",
      "meaning": "the record changed after the writer read it; carries the current version"
    },
    {
      "code": "change_conflict",
      "meaning": "another request changed the record; carries the case id and the brief reference"
    },
    {
      "code": "request_closed",
      "meaning": "the request was stopped or ended"
    },
    {
      "code": "needs_person_decision",
      "meaning": "the person must decide before the change is saved"
    },
    {
      "code": "record_busy",
      "meaning": "another request is writing the file or sign-in; carries when to try again"
    }
  ],
  "frame_schema": "frame.schema.json",
  "host_roles": {
    "edge_adapter": "connects outside agents (A2A)",
    "gateway": "talks to people through channels and the web",
    "installation_authority": "issues and revokes certificates and authority keys",
    "lead_host": "runs a team's lead agent",
    "scheduler": "fires schedules",
    "team_services": "the team's operations, steering, access and custody services",
    "worker_host": "runs worker agents"
  },
  "kinds": {
    "access.decision": {
      "address": "work.agent.{agent}",
      "admission": {
        "accepted_while_paused": false,
        "execution_slot": false,
        "priority": "high"
      },
      "authority": "none",
      "body": "bodies/access.decision.schema.json",
      "class": "durable",
      "description": "What became of an access request, sent to the waiting task.",
      "expiry_seconds": 604800,
      "idempotency": [
        "/body/request_id",
        "/body/status/state"
      ],
      "ledger": "access_wait_closed",
      "receivers": [
        "worker_host",
        "lead_host"
      ],
      "rendering": "none",
      "routing": "named",
      "senders": [
        "team_services"
      ],
      "topology_edge": "none",
      "wakes_model": {
        "by": "status.state",
        "values": {
          "already_held": "always",
          "denied": "always",
          "granted": "always",
          "handed_down": "always",
          "refused": "always",
          "waiting": "never",
          "withdrawn": "always"
        }
      }
    },
    "access.request": {
      "address": "work.team",
      "admission": {
        "accepted_while_paused": true,
        "execution_slot": false,
        "priority": "normal"
      },
      "authority": "optional",
      "body": "bodies/access.request.schema.json",
      "class": "durable",
      "description": "A task asks the team services for access; no model decides it.",
      "expiry_seconds": 604800,
      "idempotency": [
        "/body/request_id"
      ],
      "ledger": "access_wait_open",
      "receivers": [
        "team_services"
      ],
      "rendering": "none",
      "routing": "team",
      "senders": [
        "worker_host",
        "lead_host"
      ],
      "topology_edge": "none",
      "wakes_model": "never"
    },
    "access.resolved": {
      "address": "work.team",
      "admission": {
        "accepted_while_paused": true,
        "execution_slot": false,
        "priority": "normal"
      },
      "authority": "required",
      "body": "bodies/access.resolved.schema.json",
      "class": "durable",
      "description": "A person's decision on an access request, from the gateway to the team services.",
      "expiry_seconds": 604800,
      "idempotency": [
        "/body/request_id"
      ],
      "ledger": "none",
      "receivers": [
