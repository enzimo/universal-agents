      "ledger": "setup_wait_closed",
      "receivers": [
        "lead_host"
      ],
      "rendering": "summary",
      "routing": "requester",
      "senders": [
        "gateway"
      ],
      "topology_edge": "person",
      "wakes_model": "never"
    }
  },
  "max_frame_bytes": 262144,
  "max_nesting_depth": 64,
  "protocol": "1.0-pre",
  "signing_domain": "universal-agents/message-frame/v1",
  "state_records": {
    "agent_session": {
      "body": "state/agent_session.schema.json",
      "bucket": "UA1_CERTS",
      "description": "An agent session certificate, issued by the team services that place the agent.",
      "key": "session.<installation>.<team>.<session>",
      "signer": "host",
      "signer_roles": [
        "team_services"
      ],
      "write_rule": "rewritten with a higher sequence to renew it or to record its actual end; kept until its end plus the longest kind lifetime",
      "writers": [
        "team_services",
        "edge_adapter"
      ]
    },
    "agreement": {
      "body": "state/agreement.schema.json",
      "bucket": "UA1_CERTS",
      "description": "A federation agreement with another installation.",
      "key": "agreement.<peer>",
      "signer": "authority",
      "write_rule": "rewritten with a higher sequence to change or end it; only the receiver's own authority signs it",
      "writers": [
        "installation_authority"
      ]
    },
    "certificate": {
      "body": "state/certificate.schema.json",
      "bucket": "UA1_CERTS",
      "description": "A host's membership certificate.",
      "key": "host.<installation>.<runtime>.<membership_epoch>",
      "signer": "authority",
      "write_rule": "written once; kept until its expiry plus the longest kind lifetime, so queued frames can still be checked",
      "writers": [
        "installation_authority",
        "edge_adapter"
      ]
    },
    "revocations": {
      "body": "state/revocations.schema.json",
      "bucket": "UA1_CERTS",
      "description": "An installation's revoked certificates.",
      "key": "revocations.<installation>",
      "signer": "authority",
      "write_rule": "rewritten with a higher sequence on each revocation; the revocation epoch only grows and entries are never removed while a revoked certificate could still be named",
      "writers": [
        "installation_authority",
        "edge_adapter"
      ]
    }
  },
  "state_schema": "state.schema.json",
  "state_signing_domain": "universal-agents/state-record/v1",
  "verification_refusals": [
    {
      "code": "too_large",
      "meaning": "the serialized frame is larger than max_frame_bytes"
    },
    {
      "code": "malformed",
      "meaning": "the frame is not one JSON object, repeats a key, holds a number with a fraction or exponent part, or breaks the frame schema"
    },
    {
      "code": "unknown_key",
      "meaning": "the trust store holds no certificate for the issuer's installation, runtime and membership epoch that names the issuer's key id and was valid when the frame was issued, or the installation is neither the receiver's nor one it has an agreement with"
    },
    {
      "code": "bad_signature",
      "meaning": "the signature is not the one unpadded base64url spelling of a signature that verifies over the canonical frame with the certificate's key"
    },
    {
      "code": "bad_digest",
      "meaning": "the body digest does not match the body"
    },
    {
      "code": "revoked",
      "meaning": "the issuer's certificate, or the certificate that signed the issuer's agent session, is listed in its installation's revocations, whenever it was revoked and whenever the frame says it was issued"
    },
    {
      "code": "epoch_too_old",
      "meaning": "the issuer's certificate has a membership or revocation epoch below the receiver's minimum for that runtime or installation"
    },
    {
      "code": "wrong_issuer",
      "meaning": "the issuer's revocation epoch or team disagrees with its certificate; or it names an agent without a session, or a session that does not place that agent, of a type the certificate allows, on the signing runtime when the frame was issued; or a reply does not come from the agent and team the request was for"
    },
    {
      "code": "wrong_sender",
      "meaning": "none of the certificate's roles may send the kind (for a reply, receive its request); or the frame comes from another installation with a kind, class or destination team its agreement does not allow"
    },
    {
      "code": "wrong_team",
      "meaning": "the frame is for another installation or team"
    },
    {
      "code": "wrong_audience",
      "meaning": "the frame names another receiver"
    },
    {
      "code": "subject_mismatch",
      "meaning": "the subject is not ua.v1.<audience team>.<sender slot>.<address> for the kind and audience target, the frame arrived on another subject, or a NATS header copy disagrees with the frame; replies use the audience runtime's inbox and name their request"
    },
    {
      "code": "expired",
      "meaning": "the receiver's clock, less the clock tolerance, is at or after the frame's expiry or its kind's lifetime"
    },
    {
      "code": "not_yet_valid",
      "meaning": "the frame's issue or not-before time is more than the clock tolerance ahead of the receiver's clock"
    },
    {
      "code": "replayed",
      "meaning": "a frame with the same issuer installation, runtime, membership epoch and message id was admitted with other content"
    },
    {
      "code": "unknown_kind",
      "meaning": "the kind is not in this registry"
    },
    {
      "code": "invalid_body",
      "meaning": "the body breaks the kind's schema, or the idempotency key is not the one the kind's key parts give"
    },
    {
      "code": "bad_authority",
      "meaning": "the frame carries an authority token its kind does not take or lacks one it requires; or the token is not signed by a gateway or scheduler certificate of its own installation, names another team than the issuer's, was not valid when the frame was issued, lasts longer than authority_token_max_seconds, or is bound to another root task or command than the one the receiver holds"
    },
    {
      "code": "access_denied",
      "meaning": "the receiver's access decision refused the sender"
    }
  ]
}
