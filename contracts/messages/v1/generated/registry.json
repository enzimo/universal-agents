  "max_frame_bytes": 262144,
  "protocol": "1.0-pre",
  "signing_domain": "universal-agents/message-frame/v1",
  "verification_refusals": [
    {
      "code": "too_large",
      "meaning": "the serialized frame is larger than max_frame_bytes"
    },
    {
      "code": "malformed",
      "meaning": "the frame is not one JSON object, repeats a key, holds a non-integer number or breaks the frame schema"
    },
    {
